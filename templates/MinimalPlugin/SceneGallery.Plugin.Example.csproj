<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);SceneGallery.Plugin.Example.Tests\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SceneGallery.PluginSdk" Version="1.3.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <InternalsVisibleTo Include="SceneGallery.Plugin.Example.Tests" />
  </ItemGroup>
</Project>

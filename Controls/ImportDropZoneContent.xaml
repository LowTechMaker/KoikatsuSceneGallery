<UserControl
    x:Class="KoikatsuSceneGallery.Controls.ImportDropZoneContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <FontIcon x:Name="ArrowArtwork" FontSize="48" Glyph="&#xE896;" HorizontalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Flap angles are driven from code-behind so the box can seal on demand. -->
        <Canvas x:Name="BoxArtwork" Width="130" Height="100" Visibility="Collapsed"
                HorizontalAlignment="Center">
            <Rectangle Canvas.Left="32" Canvas.Top="50" Width="66" Height="42"
                       RadiusX="3" RadiusY="3" StrokeThickness="2"
                       Stroke="{ThemeResource TextFillColorSecondaryBrush}" />
            <!-- Each flap is hinged on the box's outer edge, so opening swings it
                 outward and down the side rather than up from the middle. -->
            <Rectangle x:Name="BoxFlapLeft" Canvas.Left="32" Canvas.Top="43" Width="33" Height="7"
                       RadiusX="2" RadiusY="2" Fill="{ThemeResource TextFillColorSecondaryBrush}">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="BoxFlapLeftRotate" CenterX="0" CenterY="7" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="BoxFlapRight" Canvas.Left="65" Canvas.Top="43" Width="33" Height="7"
                       RadiusX="2" RadiusY="2" Fill="{ThemeResource TextFillColorSecondaryBrush}">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="BoxFlapRightRotate" CenterX="33" CenterY="7" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>

        <TextBlock x:Uid="Import_DropZoneTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button x:Uid="Import_ChooseFiles" HorizontalAlignment="Center"
                Click="ChooseFiles_Click" Style="{StaticResource AccentButtonStyle}" />
        <TextBlock x:Uid="Import_DropZoneHint" Style="{StaticResource CaptionTextBlockStyle}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </StackPanel>
</UserControl>

<UserControl
    x:Class="KoikatsuSceneGallery.Controls.RatingBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="RestrictedBadge" Padding="6,2" CornerRadius="4"
                Visibility="Collapsed" Background="{ThemeResource RatingR18BadgeBrush}">
            <TextBlock x:Name="RestrictedLabel" FontSize="12" FontWeight="SemiBold"
                       Foreground="{ThemeResource RatingBadgeForegroundBrush}" />
        </Border>
        <Border x:Name="GeneralBadge" Padding="6,2" CornerRadius="4"
                Visibility="Collapsed" Background="{ThemeResource RatingAllAgesBadgeBrush}">
            <TextBlock Text="G" FontSize="12" FontWeight="SemiBold"
                       Foreground="{ThemeResource RatingBadgeForegroundBrush}" />
        </Border>
    </Grid>
</UserControl>

<UserControl
    x:Class="KoikatsuSceneGallery.Controls.RatingBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="RestrictedBadge" Padding="6,2" CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="Collapsed" Background="{ThemeResource RatingR18BadgeBrush}">
            <TextBlock Style="{StaticResource BadgeTextStyle}" x:Name="RestrictedLabel"
                       Foreground="{ThemeResource RatingBadgeForegroundBrush}" />
        </Border>
        <Border x:Name="GeneralBadge" Padding="6,2" CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="Collapsed" Background="{ThemeResource RatingAllAgesBadgeBrush}">
            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="G"
                       Foreground="{ThemeResource RatingBadgeForegroundBrush}" />
        </Border>
    </Grid>
</UserControl>

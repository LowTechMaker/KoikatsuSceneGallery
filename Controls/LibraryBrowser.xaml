<UserControl x:Class="KoikatsuSceneGallery.Controls.LibraryBrowser"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:KoikatsuSceneGallery.Controls" xmlns:models="using:KoikatsuSceneGallery.Models">
 <UserControl.KeyboardAccelerators>
  <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Invoked" />
  <KeyboardAccelerator Key="Home" Modifiers="Control" Invoked="First_Invoked" />
  <KeyboardAccelerator Key="End" Modifiers="Control" Invoked="Last_Invoked" />
 </UserControl.KeyboardAccelerators>
 <Grid x:Name="RootLayout" Padding="24,16,24,0" RowSpacing="12" SizeChanged="Browser_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="Header" ColumnSpacing="12" RowSpacing="8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4">
    <Button x:Name="BackButton" Visibility="Collapsed" x:Uid="SceneGallery_GroupBack" Click="Back_Click" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left" />
    <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="ResultCount" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
   </StackPanel>
   <StackPanel x:Name="SortControls" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <ComboBox x:Name="SortBox" x:Uid="SceneGallery_Sort" Width="150" SelectedIndex="0" SelectionChanged="Sort_Changed">
     <ComboBoxItem x:Uid="Gallery_SortName"/><ComboBoxItem x:Uid="Gallery_SortDateModified"/>
     <ComboBoxItem x:Uid="Gallery_SortFileSize"/><ComboBoxItem x:Uid="Gallery_SortShuffle"/>
    </ComboBox>
    <ToggleButton x:Name="DirectionButton" x:Uid="Gallery_SortDirection" Width="36" Click="Direction_Click"><FontIcon x:Name="DirectionIcon" Glyph="&#xE74A;" FontSize="14"/></ToggleButton>
    <ComboBox x:Name="SizeBox" x:Uid="Gallery_ThumbnailSizeComboBox" Width="132" SelectedIndex="1" SelectionChanged="Size_Changed">
     <ComboBoxItem x:Uid="Gallery_ThumbnailSizeSmall"/><ComboBoxItem x:Uid="Gallery_ThumbnailSizeMedium"/><ComboBoxItem x:Uid="Gallery_ThumbnailSizeLarge"/>
    </ComboBox>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1" Spacing="8">
   <Grid x:Name="SearchRow" ColumnSpacing="8" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <AutoSuggestBox x:Name="SearchBox" x:Uid="SceneGallery_Search" QueryIcon="Find" TextChanged="Search_Changed" QuerySubmitted="Search_Submitted" AutomationProperties.AutomationId="GallerySearchBox"/>
    <StackPanel x:Name="SearchActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
     <Button x:Name="FilterButton"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71C;" FontSize="14"/><TextBlock x:Name="FilterLabel"/></StackPanel>
      <Button.Flyout><Flyout><StackPanel Width="280" Spacing="16">
       <TextBlock x:Uid="SceneGallery_FilterHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
       <StackPanel x:Name="SpecificFilters" Spacing="12"/>
       <TextBlock x:Uid="SceneGallery_FilterHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <HyperlinkButton x:Uid="SceneGallery_FilterSettings" Click="Settings_Click" Padding="0"/>
      </StackPanel></Flyout></Button.Flyout>
     </Button>
     <Button x:Name="RandomButton" Click="Random_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B1;" FontSize="14"/><TextBlock x:Uid="SceneGallery_RandomLabel"/></StackPanel></Button>
    </StackPanel>
   </Grid>
   <StackPanel x:Name="BusyStatus" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
    <ProgressRing x:Name="BusyRing" Width="14" Height="14"/><TextBlock x:Name="BusyText" Style="{StaticResource CaptionTextBlockStyle}"/>
   </StackPanel>
  </StackPanel>
  <GridView x:Name="GalleryGrid" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Item_Click"
   ContainerContentChanging="Container_Changing" CanDragItems="True" DragItemsStarting="Drag_Starting" AutomationProperties.AutomationId="GalleryGrid">
   <GridView.ItemContainerTransitions><TransitionCollection/></GridView.ItemContainerTransitions>
   <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" CacheLength="4"/></ItemsPanelTemplate></GridView.ItemsPanel>
   <GridView.ItemContainerStyle><Style TargetType="GridViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
   </Style></GridView.ItemContainerStyle>
   <GridView.ItemTemplate><DataTemplate x:DataType="models:GalleryEntry">
    <Grid Margin="4" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
     <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Uid="Gallery_OpenFileLocation" Click="OpenFolder_Click" CommandParameter="{x:Bind}"/></MenuFlyout></Grid.ContextFlyout>
     <Border Margin="14,0,14,8" CornerRadius="8" BorderThickness="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Visibility="{x:Bind IsGroup}"/>
     <Border Margin="7,3,7,4" CornerRadius="8" BorderThickness="1" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Visibility="{x:Bind IsGroup}"/>
     <Grid Padding="4" Margin="0,6,0,0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
       <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image x:Phase="1" Stretch="Uniform" Source="{x:Bind local:LibraryBrowser.Thumbnail(Card.ThumbnailUri), Mode=OneWay}"/></Border>
       <local:RatingBadge HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Text="{x:Bind RatingText, Mode=OneWay}" />
       <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="8,5" CornerRadius="5" Background="#E6202020" Visibility="{x:Bind IsGroup}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="White"/><TextBlock Text="{x:Bind CountText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border>
       <!-- One badge for both facts: a second Border would crowd the corner. -->
       <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="6,3" CornerRadius="4" Background="#E6202020" Visibility="{x:Bind HasVersionBadge, Mode=OneWay}"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{x:Bind AlternateText, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}" FontSize="11" FontWeight="SemiBold" Visibility="{x:Bind HasAlternateVersions, Mode=OneWay}"/><TextBlock Text="{x:Bind VersionText, Mode=OneWay}" Foreground="White" FontSize="11" Visibility="{x:Bind HasVersions, Mode=OneWay}"/></StackPanel></Border>
      </Grid>
      <StackPanel Grid.Row="1" Height="{x:Bind MetadataHeight}" Padding="8,4" VerticalAlignment="Center" Spacing="2">
       <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" Visibility="{x:Bind ShowTitle}"/>
       <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Ellipse Width="16" Height="16" Visibility="{x:Bind Author.HasAvatar, Mode=OneWay}"><Ellipse.Fill><ImageBrush ImageSource="{x:Bind Author.AvatarSource, Mode=OneWay}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
        <TextBlock Grid.Column="1" Text="{x:Bind AuthorText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       </Grid>
      </StackPanel>
     </Grid>
    </Grid>
   </DataTemplate></GridView.ItemTemplate>
  </GridView>
  <StackPanel x:Name="EmptyPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="440" Visibility="Collapsed">
   <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
   <TextBlock x:Name="EmptyDescription" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   <Button x:Name="ClearButton" Click="Clear_Click" HorizontalAlignment="Center"/>
   <HyperlinkButton x:Uid="SceneGallery_FilterSettings" Click="Settings_Click" HorizontalAlignment="Center"/>
  </StackPanel>
 </Grid>
</UserControl>

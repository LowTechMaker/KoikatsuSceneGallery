<UserControl x:Class="KoikatsuSceneGallery.Controls.LibraryBrowser"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:KoikatsuSceneGallery.Controls" xmlns:models="using:KoikatsuSceneGallery.Models" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
 <UserControl.KeyboardAccelerators>
  <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Invoked" />
  <KeyboardAccelerator Key="Home" Modifiers="Control" Invoked="First_Invoked" />
  <KeyboardAccelerator Key="End" Modifiers="Control" Invoked="Last_Invoked" />
  <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="Inspector_Invoked" />
 </UserControl.KeyboardAccelerators>
 <Grid x:Name="RootLayout" Padding="{StaticResource PageContentPadding}" RowSpacing="12" SizeChanged="Browser_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <!-- The second column is the details pane (CardInspector, added in code), beside the grid only. -->
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Grid x:Name="Header" Grid.ColumnSpan="2" ColumnSpacing="12" RowSpacing="8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4">
    <Button x:Name="BackButton" Visibility="Collapsed" x:Uid="SceneGallery_GroupBack" Click="Back_Click" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left" />
    <TextBlock x:Name="Heading" Style="{StaticResource PageTitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
   </StackPanel>
   <!-- The count sits with the controls that change it rather than under the
        title: on its own line below a heading it was the loudest thing on a
        page whose subject is the cards. -->
   <StackPanel x:Name="SortControls" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <TextBlock x:Name="ResultCount" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
    <!-- Tag, not index: SortOption gains values over time and a silent
         off-by-one here would sort by the wrong column with no compile error. -->
    <!-- Order is one decision, so it is one control. A field ComboBox beside a
         direction toggle made the reader combine two controls to learn what
         the order is, and the toggle carried the accent fill that both Fluent
         and HIG reserve for a view's single primary action - which sort
         direction is not. -->
    <DropDownButton x:Name="SortButton" x:Uid="SceneGallery_Sort" AutomationProperties.AutomationId="GallerySortButton">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <FontIcon x:Name="DirectionIcon" Glyph="&#xE74B;" FontSize="14"/>
      <TextBlock x:Name="SortLabel"/>
     </StackPanel>
     <DropDownButton.Flyout>
      <MenuFlyout Placement="BottomEdgeAlignedRight">
       <RadioMenuFlyoutItem x:Name="SortByName" x:Uid="Gallery_SortName" Tag="Name" GroupName="sort" Click="SortField_Click"/>
       <RadioMenuFlyoutItem x:Name="SortByDateModified" x:Uid="Gallery_SortDateModified" Tag="DateModified" GroupName="sort" Click="SortField_Click"/>
       <RadioMenuFlyoutItem x:Name="SortByDateAdded" x:Uid="Gallery_SortDateAdded" Tag="DateAdded" GroupName="sort" Click="SortField_Click"/>
       <RadioMenuFlyoutItem x:Name="SortByFileSize" x:Uid="Gallery_SortFileSize" Tag="FileSize" GroupName="sort" Click="SortField_Click"/>
       <RadioMenuFlyoutItem x:Name="SortByShuffle" x:Uid="Gallery_SortShuffle" Tag="Shuffle" GroupName="sort" Click="SortField_Click"/>
       <MenuFlyoutSeparator/>
       <RadioMenuFlyoutItem x:Name="SortDescendingItem" x:Uid="Gallery_SortDescending" Tag="Descending" GroupName="direction" Click="SortDirection_Click"/>
       <RadioMenuFlyoutItem x:Name="SortAscendingItem" x:Uid="Gallery_SortAscending" Tag="Ascending" GroupName="direction" Click="SortDirection_Click"/>
      </MenuFlyout>
     </DropDownButton.Flyout>
    </DropDownButton>
    <!-- Three exclusive values: a segmented control shows all of them and takes
         one click, where a ComboBox hides two thirds of the choice behind a
         menu. Both design systems draw the line at about five. -->
    <toolkit:Segmented x:Name="SizeSegmented" x:Uid="Gallery_ThumbnailSizeComboBox" AutomationProperties.AutomationId="GallerySizeSegmented" SelectedIndex="1" SelectionChanged="Size_Changed">
     <toolkit:SegmentedItem x:Uid="Gallery_ThumbnailSizeSmall"/>
     <toolkit:SegmentedItem x:Uid="Gallery_ThumbnailSizeMedium"/>
     <toolkit:SegmentedItem x:Uid="Gallery_ThumbnailSizeLarge"/>
    </toolkit:Segmented>
    <ToggleButton x:Name="InspectorToggle" AutomationProperties.AutomationId="GalleryInspectorToggle" Click="InspectorToggle_Click" Padding="8,6"><FontIcon Glyph="&#xE8A0;" FontSize="14"/></ToggleButton>
   </StackPanel>
  </Grid>
  <StackPanel x:Name="SearchArea" Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
   <Grid x:Name="SearchRow" ColumnSpacing="8" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <AutoSuggestBox x:Name="SearchBox" x:Uid="SceneGallery_Search" QueryIcon="Find" TextChanged="Search_Changed" QuerySubmitted="Search_Submitted" AutomationProperties.AutomationId="GallerySearchBox"/>
    <StackPanel x:Name="SearchActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
     <!-- The active count is a badge rather than part of the label: it is a
          state of the control, not a different control, and it stops the label
          changing width as filters come and go. -->
     <Button x:Name="FilterButton" AutomationProperties.AutomationId="GalleryFilterButton"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71C;" FontSize="14"/><TextBlock x:Name="FilterLabel"/><InfoBadge x:Name="FilterBadge" Visibility="Collapsed" VerticalAlignment="Center"/></StackPanel>
      <Button.Flyout><Flyout><StackPanel Width="280" Spacing="16">
       <TextBlock x:Uid="SceneGallery_FilterHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
       <StackPanel x:Name="SpecificFilters" Spacing="12"/>
       <!-- The switch lives here, beside the other filters; only the list of sizes is edited in settings. -->
       <ToggleSwitch x:Name="ResolutionToggle" x:Uid="Browser_ResolutionToggle" AutomationProperties.AutomationId="GalleryResolutionToggle" Visibility="Collapsed" Toggled="ResolutionToggle_Toggled"/>
       <TextBlock x:Name="ResolutionFilterStatus" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <!-- Cards with no author yet: the list to work through when adding sources afterwards. -->
       <ToggleSwitch x:Name="NoSourceToggle" x:Uid="Browser_NoSourceToggle" AutomationProperties.AutomationId="GalleryNoSourceToggle" Toggled="NoSourceToggle_Toggled"/>
       <!-- The only way back for a card marked "not for me": it is hidden everywhere else. -->
       <ToggleSwitch x:Name="ShowHiddenToggle" x:Uid="Browser_ShowHiddenToggle" AutomationProperties.AutomationId="GalleryShowHiddenToggle" Toggled="ShowHiddenToggle_Toggled"/>
       <TextBlock x:Uid="SceneGallery_FilterHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <HyperlinkButton x:Uid="SceneGallery_FilterSettings" Click="Settings_Click" Padding="0"/>
      </StackPanel></Flyout></Button.Flyout>
     </Button>
     <Button x:Name="RandomButton" Click="Random_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B1;" FontSize="14"/><TextBlock x:Uid="SceneGallery_RandomLabel"/></StackPanel></Button>
    </StackPanel>
   </Grid>
   <!-- Active filters, each removable (LibraryBrowser.FilterChips.cs). -->
   <local:WrapPanel x:Name="FilterChips" Spacing="6" Visibility="Collapsed" AutomationProperties.AutomationId="GalleryFilterChips"/>
   <StackPanel x:Name="BusyStatus" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
    <ProgressRing x:Name="BusyRing" Width="14" Height="14"/><TextBlock x:Name="BusyText" Style="{StaticResource CaptionTextBlockStyle}"/>
   </StackPanel>
  </StackPanel>
  <!-- A click selects (the details pane shows it); a double click or Enter opens.
       Extended: Ctrl and Shift select several, Ctrl+A all. -->
  <GridView x:Name="GalleryGrid" Grid.Row="2" SelectionMode="Extended" IsItemClickEnabled="False"
   SelectionChanged="Grid_SelectionChanged" DoubleTapped="Grid_DoubleTapped" PreviewKeyDown="Grid_PreviewKeyDown"
   ContainerContentChanging="Container_Changing" CanDragItems="True" DragItemsStarting="Drag_Starting" AutomationProperties.AutomationId="GalleryGrid">
   <GridView.ItemContainerTransitions><TransitionCollection/></GridView.ItemContainerTransitions>
   <!-- The tile draws its own selection mark (GalleryEntry.IsSelected). The grid's own
        selected background filled the whole cell, a grey block wider than the tile. -->
   <GridView.Resources>
    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent"/>
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/>
    <x:Boolean x:Key="GridViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
    <Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>
   </GridView.Resources>
   <!-- A size from the start (GalleryLayoutEngine fits it to the width at once): without one,
        a tab opened for the first time laid out its ~1,800 cards at the size of their loading
        placeholders, a field of tiny icons for seconds (user report, four times). -->
   <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" CacheLength="4" ItemWidth="248" ItemHeight="248"/></ItemsPanelTemplate></GridView.ItemsPanel>
   <GridView.ItemContainerStyle><Style TargetType="GridViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
   </Style></GridView.ItemContainerStyle>
   <GridView.ItemTemplate><DataTemplate x:DataType="models:GalleryEntry">
    <!-- Like Google Photos (user request): the pictures sit edge to edge with a thin gap
         (GalleryLayoutEngine.CardMargin), no card frame, background or padding around them.
         With file names on, the title and the author go under the picture; off, it is the
         picture and its badges only. A group is its cover with the count badge (the cards
         that used to peek out behind it needed room around every tile). -->
    <Grid Margin="1" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
     <!-- Filled when it opens (LibraryBrowser.CardMenu.cs): what it offers depends on the tile. -->
     <Grid.ContextFlyout><MenuFlyout Opening="CardMenu_Opening"/></Grid.ContextFlyout>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid>
      <!-- A group, like the details pane's stack of selected cards: its next two cards
           fanned out behind the cover (their own pictures), the count on a round badge. -->
      <Border Margin="{x:Bind FaceMargin}" Visibility="{x:Bind HasThirdLayer}" RenderTransformOrigin="0.5,0.5" Opacity="0.7"
              BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
       <Border.RenderTransform><CompositeTransform Rotation="7" TranslateX="6" TranslateY="-4"/></Border.RenderTransform>
       <Image Stretch="UniformToFill" Source="{x:Bind local:LibraryBrowser.StackThumbnail(ThirdCard.ThumbnailUri), Mode=OneWay}"/>
      </Border>
      <Border Margin="{x:Bind FaceMargin}" Visibility="{x:Bind IsGroup}" RenderTransformOrigin="0.5,0.5" Opacity="0.85"
              BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
       <Border.RenderTransform><CompositeTransform Rotation="3.5" TranslateX="3" TranslateY="-2"/></Border.RenderTransform>
       <Image Stretch="UniformToFill" Source="{x:Bind local:LibraryBrowser.StackThumbnail(SecondCard.ThumbnailUri), Mode=OneWay}"/>
      </Border>
      <Grid Margin="{x:Bind FaceMargin}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
       <Image x:Phase="1" Stretch="UniformToFill" Source="{x:Bind local:LibraryBrowser.Thumbnail(Card.ThumbnailUri), Mode=OneWay}"/>
       <!-- Until the thumbnail exists: a pulse that says "loading" rather than a flat
            block that looks stuck. Shown off the path only; the image pipeline is untouched. -->
      <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" Visibility="{x:Bind local:LibraryBrowser.PlaceholderVisibility(Card.ThumbnailUri), Mode=OneWay}" Loaded="Placeholder_Loaded">
       <FontIcon Glyph="&#xE91B;" FontSize="20" Foreground="{ThemeResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
       <local:RatingBadge HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Text="{x:Bind RatingText, Mode=OneWay}" />
       <!-- One badge for both facts: a second Border would crowd the corner. -->
      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource MediaOverlayBadgeStyle}" Visibility="{x:Bind HasVersionBadge, Mode=OneWay}"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{x:Bind AlternateText, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}" FontSize="11" FontWeight="SemiBold" Visibility="{x:Bind HasAlternateVersions, Mode=OneWay}"/><TextBlock Text="{x:Bind VersionText, Mode=OneWay}" Foreground="{ThemeResource MediaOverlayForegroundBrush}" FontSize="11" Visibility="{x:Bind HasVersions, Mode=OneWay}"/></StackPanel></Border>
       <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" MinWidth="26" Height="26" Padding="8,0" CornerRadius="13"
               Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsGroup}"
               AutomationProperties.Name="{x:Bind CountText}">
        <TextBlock Text="{x:Bind MemberCountText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
       </Border>
       <!-- The selection mark (GalleryEntry.IsSelected): an accent frame inside the picture,
            a light accent wash and a check in the corner. -->
       <Grid IsHitTestVisible="False" Visibility="{x:Bind IsSelected, Mode=OneWay}">
        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.2"/>
        <Border BorderThickness="3" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Border Width="24" Height="24" Margin="8" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}">
        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
        </Border>
       </Grid>
      </Grid>
     </Grid>
     <StackPanel Grid.Row="1" Height="{x:Bind MetadataHeight}" Padding="2,4,2,0" Spacing="0" Visibility="{x:Bind ShowTitle}">
      <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
      <TextBlock Text="{x:Bind AuthorText, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
    </Grid>
   </DataTemplate></GridView.ItemTemplate>
  </GridView>
  <StackPanel x:Name="EmptyPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="440" Visibility="Collapsed">
   <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
   <TextBlock x:Name="EmptyDescription" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   <Button x:Name="ClearButton" Click="Clear_Click" HorizontalAlignment="Center"/>
   <HyperlinkButton x:Uid="SceneGallery_FilterSettings" Click="Settings_Click" HorizontalAlignment="Center"/>
  </StackPanel>
 </Grid>
</UserControl>

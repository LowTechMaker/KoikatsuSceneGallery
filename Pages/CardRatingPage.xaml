<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.CardRatingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KoikatsuSceneGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContentPaddingClosed}" RowSpacing="{StaticResource PageRowSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" x:Uid="Rating_Header" />

        <Grid
            x:Name="CardPanel"
            Grid.Row="1"
            MaxWidth="960"
            RowSpacing="{StaticResource Space12}"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image
                x:Name="CardImage"
                AutomationProperties.AutomationId="RatingCardImage"
                Stretch="Uniform" />
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="FileNameText"
                    HorizontalAlignment="Center"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="AuthorText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <Border x:Name="PickerHost" Grid.Row="2" />
            <Grid Grid.Row="3">
                <Button
                    x:Name="PreviousButton"
                    x:Uid="Rating_Previous"
                    AutomationProperties.AutomationId="RatingPrevious"
                    Click="Previous_Click"
                    IsEnabled="False" />
                <TextBlock
                    x:Uid="Rating_KeyHint"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Grid>

        <StackPanel
            x:Name="StatusPanel"
            Grid.Row="1"
            MaxWidth="{StaticResource EmptyStateMaxWidth}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{StaticResource Space12}">
            <ProgressRing x:Name="BusyRing" HorizontalAlignment="Center" IsActive="False" />
            <TextBlock
                x:Name="StatusTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="StatusDescription"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="StatusPreviousButton"
                x:Uid="Rating_Previous"
                HorizontalAlignment="Center"
                Click="Previous_Click"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>

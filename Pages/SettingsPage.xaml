<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appControls="using:KoikatsuSceneGallery.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KoikatsuSceneGallery.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsScrollStyle" TargetType="ScrollViewer">
            <Setter Property="Padding" Value="0,16,12,24" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollMode" Value="Disabled" />
        </Style>
        <Style x:Key="SettingsIntroStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SettingsListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="FilterCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <ItemsPanelTemplate x:Key="ResolutionChipPanel">
            <appControls:WrapPanel Spacing="8" />
        </ItemsPanelTemplate>
        <Style x:Key="ResolutionChipStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,24,24,0" RowSpacing="12" MaxWidth="1160" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="Settings_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="Settings_Subtitle" Style="{StaticResource SettingsIntroStyle}" Margin="0" />
            <InfoBar x:Uid="Settings_SaveError" IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                     IsClosable="False" Severity="Error" AutomationProperties.AutomationId="SettingsSaveError">
                <InfoBar.ActionButton>
                    <Button x:Uid="Settings_RetrySave" Command="{x:Bind ViewModel.SaveConfigCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <Pivot x:Name="SettingsCategories" Grid.Row="1" AutomationProperties.AutomationId="SettingsCategories">

            <!-- General Tab -->
            <PivotItem x:Uid="Settings_TabGeneral">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="8">

                        <!-- Display Section -->
                        <TextBlock
                            x:Uid="Settings_DisplayHeader"
                            Margin="1,0,0,4"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Uid="SC_ShowFileNames"
                            AutomationProperties.AutomationId="SettingsShowFileNamesCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE91B;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsShowFileNamesToggle"
                                IsOn="{x:Bind ViewModel.ShowFileNames, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_ScrollToTop"
                            AutomationProperties.AutomationId="SettingsScrollToTopCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE74A;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsScrollToTopToggle"
                                IsOn="{x:Bind ViewModel.ScrollToTopOnSort, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_AuthorLiveTiles"
                            AutomationProperties.AutomationId="SettingsAuthorLiveTilesCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A9;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsAuthorLiveTilesToggle"
                                IsOn="{x:Bind ViewModel.AuthorLiveTilesEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <!-- Navigation Visibility Section -->
                        <TextBlock
                            x:Uid="Settings_NavigationHeader"
                            Margin="1,12,0,4"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Uid="SC_Navigation"
                            AutomationProperties.AutomationId="SettingsNavigationCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE700;" />
                            </controls:SettingsCard.HeaderIcon>
                            <appControls:WrapPanel Spacing="12" MaxWidth="540">
                                <CheckBox
                                    x:Uid="Settings_ShowGalleryNav"
                                    IsChecked="{x:Bind ViewModel.ShowGalleryNav, Mode=TwoWay}" />
                                <CheckBox
                                    x:Uid="Settings_ShowCharactersNav"
                                    IsChecked="{x:Bind ViewModel.ShowCharactersNav, Mode=TwoWay}" />
                                <CheckBox
                                    x:Uid="Settings_ShowCoordinatesNav"
                                    IsChecked="{x:Bind ViewModel.ShowCoordinatesNav, Mode=TwoWay}" />
                                <CheckBox
                                    x:Uid="Settings_ShowScreenshotsNav"
                                    IsChecked="{x:Bind ViewModel.ShowScreenshotsNav, Mode=TwoWay}" />
                            </appControls:WrapPanel>
                        </controls:SettingsCard>

                        <!-- Language Section -->
                        <TextBlock
                            x:Uid="Settings_LanguageHeader"
                            Margin="1,12,0,4"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Uid="SC_Language"
                            AutomationProperties.AutomationId="SettingsLanguageCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE774;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="LanguageComboBox"
                                AutomationProperties.AutomationId="SettingsLanguageComboBox"
                                MinWidth="200"
                                SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="Settings_LanguageSystem" Tag="" />
                                <ComboBoxItem Content="English" Tag="en-US" />
                                <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <InfoBar
                            x:Uid="Settings_RestartInfo"
                            Margin="0,4,0,0"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.ShowRestartHint, Mode=OneWay}"
                            Severity="Informational">
                            <InfoBar.ActionButton>
                                <Button x:Uid="Settings_RestartButton" Click="RestartApp_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Folders Tab -->
            <PivotItem x:Uid="Settings_TabFolders">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="8">

                        <TextBlock x:Uid="Settings_FoldersIntro" Style="{StaticResource SettingsIntroStyle}" />
                        <!-- Scene Folders -->
                        <Border Padding="16" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_FoldersHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.FolderPaths.Count, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.AddFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE8DA;" />
                                            <TextBlock x:Uid="Settings_AddFolder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Uid="Settings_FoldersDesc" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView
                                    x:Name="FolderListView"
                                    ItemsSource="{x:Bind ViewModel.FolderPaths, Mode=OneWay}"
                                    ItemContainerStyle="{StaticResource SettingsListItemStyle}"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Padding="0,2" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8B7;" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind}" />
                                                <Button x:Uid="Settings_RemoveFolder" Grid.Column="2" VerticalAlignment="Center" CommandParameter="{x:Bind}" Click="RemoveFolder_Click" Style="{StaticResource SubtleButtonStyle}">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Uid="Settings_NoFolders" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.HasNoFolders, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Character Card Folders -->
                        <Border Padding="16" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_CharaFoldersHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.CharacterFolderPaths.Count, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.AddCharacterFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE8DA;" />
                                            <TextBlock x:Uid="Settings_AddFolder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Uid="Settings_CharaFoldersDesc" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView
                                    x:Name="CharacterFolderListView"
                                    ItemsSource="{x:Bind ViewModel.CharacterFolderPaths, Mode=OneWay}"
                                    ItemContainerStyle="{StaticResource SettingsListItemStyle}"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Padding="0,2" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8B7;" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind}" />
                                                <Button x:Uid="Settings_RemoveFolder" Grid.Column="2" VerticalAlignment="Center" CommandParameter="{x:Bind}" Click="RemoveCharacterFolder_Click" Style="{StaticResource SubtleButtonStyle}">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Uid="Settings_NoFolders" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.HasNoCharacterFolders, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Coordinate Card Folders -->
                        <Border Padding="16" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_CoordFoldersHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.CoordinateFolderPaths.Count, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.AddCoordinateFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE8DA;" />
                                            <TextBlock x:Uid="Settings_AddFolder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Uid="Settings_CoordFoldersDesc" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView
                                    x:Name="CoordinateFolderListView"
                                    ItemsSource="{x:Bind ViewModel.CoordinateFolderPaths, Mode=OneWay}"
                                    ItemContainerStyle="{StaticResource SettingsListItemStyle}"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Padding="0,2" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8B7;" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind}" />
                                                <Button x:Uid="Settings_RemoveFolder" Grid.Column="2" VerticalAlignment="Center" CommandParameter="{x:Bind}" Click="RemoveCoordinateFolder_Click" Style="{StaticResource SubtleButtonStyle}">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Uid="Settings_NoFolders" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.HasNoCoordinateFolders, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Screenshot Folders -->
                        <Border Padding="16" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_ScreenshotFoldersHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.ScreenshotFolderPaths.Count, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.AddScreenshotFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE8DA;" />
                                            <TextBlock x:Uid="Settings_AddFolder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Uid="Settings_ScreenshotFoldersDesc" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView
                                    x:Name="ScreenshotFolderListView"
                                    ItemsSource="{x:Bind ViewModel.ScreenshotFolderPaths, Mode=OneWay}"
                                    ItemContainerStyle="{StaticResource SettingsListItemStyle}"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Padding="0,2" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8B7;" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind}" />
                                                <Button x:Uid="Settings_RemoveFolder" Grid.Column="2" VerticalAlignment="Center" CommandParameter="{x:Bind}" Click="RemoveScreenshotFolder_Click" Style="{StaticResource SubtleButtonStyle}">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Uid="Settings_NoFolders" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.HasNoScreenshotFolders, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Filters Tab -->
            <PivotItem x:Uid="Settings_TabFilters">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Settings_SizeFiltersHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="Settings_FiltersIntro" Style="{StaticResource SettingsIntroStyle}" />
                        <Border Style="{StaticResource FilterCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE91B;" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_SceneResolutionHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind GetResolutionFilterSummary(ViewModel.ResolutionFilterEnabled, ViewModel.AllowedResolutions.Count), Mode=OneWay}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   AutomationProperties.AutomationId="SettingsSceneFilterSummary" />
                                    </StackPanel>
                                    <ToggleSwitch x:Uid="Settings_SceneFilterToggle" Grid.Column="2" VerticalAlignment="Center"
                                                  IsOn="{x:Bind ViewModel.ResolutionFilterEnabled, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="SettingsSceneFilterToggle"
                                                  OnContent="" OffContent="" MinWidth="0" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AllowedResolutions, Mode=OneWay}"
                                              IsEnabled="{x:Bind ViewModel.ResolutionFilterEnabled, Mode=OneWay}"
                                              ItemsPanel="{StaticResource ResolutionChipPanel}"
                                              AutomationProperties.AutomationId="SettingsSceneResolutionChips">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Click="RemoveResolution_Click" CommandParameter="{x:Bind}"
                                                    Style="{StaticResource ResolutionChipStyle}"
                                                    AutomationProperties.Name="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}"
                                                    ToolTipService.ToolTip="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind}" />
                                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ResolutionFilterEnabled, Mode=OneWay}">
                                    <Grid ColumnSpacing="8" HorizontalAlignment="Left" MaxWidth="360">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ResolutionInput" x:Uid="Settings_ResolutionInput" MinWidth="140"
                                                 KeyDown="ResolutionInput_KeyDown" TextChanged="ResolutionInput_TextChanged" />
                                        <Button x:Uid="Settings_AddSize" Grid.Column="1" Click="AddResolution_Click" />
                                    </Grid>
                                    <TextBlock x:Name="ResolutionError" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FilterCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_CharaResolutionHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind GetResolutionFilterSummary(ViewModel.CharacterResolutionFilterEnabled, ViewModel.CharacterAllowedResolutions.Count), Mode=OneWay}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   AutomationProperties.AutomationId="SettingsCharaFilterSummary" />
                                    </StackPanel>
                                    <ToggleSwitch x:Uid="Settings_CharaFilterToggle" Grid.Column="2" VerticalAlignment="Center"
                                                  IsOn="{x:Bind ViewModel.CharacterResolutionFilterEnabled, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="SettingsCharaFilterToggle"
                                                  OnContent="" OffContent="" MinWidth="0" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CharacterAllowedResolutions, Mode=OneWay}"
                                              IsEnabled="{x:Bind ViewModel.CharacterResolutionFilterEnabled, Mode=OneWay}"
                                              ItemsPanel="{StaticResource ResolutionChipPanel}"
                                              AutomationProperties.AutomationId="SettingsCharaResolutionChips">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Click="RemoveCharacterResolution_Click" CommandParameter="{x:Bind}"
                                                    Style="{StaticResource ResolutionChipStyle}"
                                                    AutomationProperties.Name="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}"
                                                    ToolTipService.ToolTip="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind}" />
                                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CharacterResolutionFilterEnabled, Mode=OneWay}">
                                    <Grid ColumnSpacing="8" HorizontalAlignment="Left" MaxWidth="360">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CharacterResolutionInput" x:Uid="Settings_CharaResolutionInput" MinWidth="140"
                                                 KeyDown="CharacterResolutionInput_KeyDown" TextChanged="ResolutionInput_TextChanged" />
                                        <Button x:Uid="Settings_AddSize" Grid.Column="1" Click="AddCharacterResolution_Click" />
                                    </Grid>
                                    <TextBlock x:Name="CharacterResolutionError" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FilterCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_CoordResolutionHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind GetResolutionFilterSummary(ViewModel.CoordinateResolutionFilterEnabled, ViewModel.CoordinateAllowedResolutions.Count), Mode=OneWay}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   AutomationProperties.AutomationId="SettingsCoordFilterSummary" />
                                    </StackPanel>
                                    <ToggleSwitch x:Uid="Settings_CoordFilterToggle" Grid.Column="2" VerticalAlignment="Center"
                                                  IsOn="{x:Bind ViewModel.CoordinateResolutionFilterEnabled, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="SettingsCoordFilterToggle"
                                                  OnContent="" OffContent="" MinWidth="0" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CoordinateAllowedResolutions, Mode=OneWay}"
                                              IsEnabled="{x:Bind ViewModel.CoordinateResolutionFilterEnabled, Mode=OneWay}"
                                              ItemsPanel="{StaticResource ResolutionChipPanel}"
                                              AutomationProperties.AutomationId="SettingsCoordResolutionChips">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Click="RemoveCoordinateResolution_Click" CommandParameter="{x:Bind}"
                                                    Style="{StaticResource ResolutionChipStyle}"
                                                    AutomationProperties.Name="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}"
                                                    ToolTipService.ToolTip="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind}" />
                                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CoordinateResolutionFilterEnabled, Mode=OneWay}">
                                    <Grid ColumnSpacing="8" HorizontalAlignment="Left" MaxWidth="360">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CoordinateResolutionInput" x:Uid="Settings_CoordResolutionInput" MinWidth="140"
                                                 KeyDown="CoordinateResolutionInput_KeyDown" TextChanged="ResolutionInput_TextChanged" />
                                        <Button x:Uid="Settings_AddSize" Grid.Column="1" Click="AddCoordinateResolution_Click" />
                                    </Grid>
                                    <TextBlock x:Name="CoordinateResolutionError" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Uid="Settings_SceneTagsHeader" Margin="0,20,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Style="{StaticResource FilterCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEA86;" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Uid="Settings_PluginHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind GetPluginAnalysisSummary(ViewModel.PluginAnalysisEnabled), Mode=OneWay}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Uid="Settings_PluginAnalysisToggle" Grid.Column="2" VerticalAlignment="Center"
                                                  IsOn="{x:Bind ViewModel.PluginAnalysisEnabled, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="SettingsPluginAnalysisToggle" OnContent="" OffContent="" MinWidth="0" />
                                </Grid>
                                <TextBlock x:Uid="Settings_PluginDesc" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Spacing="12">
                                    <appControls:WrapPanel Spacing="8">
                                        <Button
                                            Command="{x:Bind ViewModel.ScanMissingMetadataCommand}"
                                            IsEnabled="{x:Bind CanScanMetadata(ViewModel.PluginAnalysisEnabled, GalleryViewModel.IsNotParsingMetadata), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="&#xE895;" />
                                                <TextBlock x:Uid="Settings_ScanMissing" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Command="{x:Bind ViewModel.RescanMetadataCommand}"
                                            IsEnabled="{x:Bind CanScanMetadata(ViewModel.PluginAnalysisEnabled, GalleryViewModel.IsNotParsingMetadata), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                                <TextBlock x:Uid="Settings_RescanAll" />
                                            </StackPanel>
                                        </Button>
                                    </appControls:WrapPanel>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind GalleryViewModel.IsParsingMetadata, Mode=OneWay}">
                                        <ProgressRing Width="16" Height="16" IsActive="True" />
                                        <TextBlock x:Uid="Settings_ScanProgress" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind GalleryViewModel.PendingMetadataCount, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Advanced Tab -->
            <PivotItem x:Uid="Settings_TabAdvanced">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="8">

                        <!-- Cache Section -->
                        <TextBlock
                            x:Uid="Settings_CacheHeader"
                            Margin="1,0,0,4"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Uid="SC_CacheFolder"
                            AutomationProperties.AutomationId="SettingsCacheFolderCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </controls:SettingsCard.HeaderIcon>
                            <TextBlock
                                MaxWidth="400"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CacheFolderDisplay, Mode=OneWay}"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind ViewModel.CacheFolderDisplay, Mode=OneWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_CacheUsage">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7F1;" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.CacheUsageText, Mode=OneWay}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Button x:Uid="Settings_RefreshCache" Command="{x:Bind ViewModel.RefreshCacheUsageCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanManageCache, Mode=OneWay}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_CacheActions"
                            IsEnabled="{x:Bind ViewModel.CanManageCache, Mode=OneWay}"
                            AutomationProperties.AutomationId="SettingsCacheActionsCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE90F;" />
                            </controls:SettingsCard.HeaderIcon>
                            <appControls:WrapPanel Spacing="8">
                                <Button Command="{x:Bind ViewModel.ChangeCacheFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8DA;" />
                                        <TextBlock x:Uid="Settings_ChangeFolder" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ResetCacheFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE777;" />
                                        <TextBlock x:Uid="Settings_ResetDefault" />
                                    </StackPanel>
                                </Button>
                                <Button Click="ClearCache_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        <TextBlock x:Uid="Settings_ClearCache" />
                                    </StackPanel>
                                </Button>
                            </appControls:WrapPanel>
                        </controls:SettingsCard>

                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{x:Bind ViewModel.IsCacheBusy, Mode=OneWay}" />
                        <InfoBar IsOpen="{x:Bind ViewModel.HasCacheResult, Mode=OneWay}" IsClosable="False"
                                 Severity="{x:Bind ViewModel.CacheResultSeverity, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.CacheResultMessage, Mode=OneWay}"
                                 AutomationProperties.AutomationId="SettingsCacheResult" />

                        <!-- Cache Buffer Section -->
                        <TextBlock
                            x:Uid="Settings_AdvancedHeader"
                            Margin="1,28,0,4"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Uid="SC_CacheBuffer"
                            AutomationProperties.AutomationId="SettingsCacheBufferCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7F8;" />
                            </controls:SettingsCard.HeaderIcon>
                            <NumberBox
                                AutomationProperties.AutomationId="SettingsCacheBufferNumberBox"
                                MinWidth="160"
                                LargeChange="4"
                                Maximum="40"
                                Minimum="2"
                                SmallChange="2"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.CacheLength, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <InfoBar
                            x:Uid="Settings_CacheBufferWarning"
                            Margin="0,4,0,0"
                            IsClosable="False"
                            IsOpen="True"
                            Severity="Warning" />

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Plugins Tab -->
            <PivotItem x:Uid="Settings_TabPlugins">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="20">

                        <!-- Overview -->
                        <StackPanel Spacing="16">
                            <TextBlock
                                x:Uid="Plugins_Header"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Plugins_Desc"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <InfoBar
                                x:Uid="Plugins_RiskWarning"
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Warning" />
                        </StackPanel>

                        <!-- Installed Plugins -->
                        <StackPanel Spacing="16">
                            <Button Click="OpenPluginsFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8DA;" />
                                    <TextBlock x:Uid="Plugins_OpenFolder" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                x:Uid="Plugins_RestartNote"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock
                                x:Uid="Plugins_Empty"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind HasNoPlugins}" />

                            <ItemsControl ItemsSource="{x:Bind PluginItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:PluginListItem">
                                        <Button
                                            Margin="0,0,0,8"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="PluginItem_Click"
                                            CommandParameter="{x:Bind}">
                                            <Grid
                                                Padding="16,12"
                                                ColumnSpacing="12"
                                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xEA86;" />

                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="{x:Bind Name}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Version}"
                                                            Visibility="{x:Bind HasVersion}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Description}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind HasDescription}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Error}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind HasError}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind UpdateText}"
                                                        Visibility="{x:Bind UpdateAvailable}" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind StatusText}" />

                                                <FontIcon
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE76C;" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                        <!-- Install Instructions -->
                        <Expander x:Uid="Plugins_InstallHelp" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="Plugins_InstallStepDownload"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="Plugins_InstallStepCopy"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="Plugins_InstallStepRestart"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Experimental Tab -->
            <PivotItem x:Uid="Settings_TabOcd">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="8">

                        <InfoBar
                            x:Uid="Settings_OcdDesc"
                            Margin="0,0,0,12"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Warning" />

                        <controls:SettingsCard
                            x:Uid="SC_VisualSimilarity"
                            AutomationProperties.AutomationId="SettingsVisualSimilarityCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsVisualSimilarityToggle"
                                IsOn="{x:Bind ViewModel.UseVisualSimilarity, Mode=TwoWay}" />
                        </controls:SettingsCard>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appControls="using:KoikatsuSceneGallery.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KoikatsuSceneGallery.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsScrollStyle" TargetType="ScrollViewer">
            <Setter Property="Padding" Value="0,16,12,24" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollMode" Value="Disabled" />
        </Style>
        <Style x:Key="SettingsIntroStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SettingsListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="FilterCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <ItemsPanelTemplate x:Key="ResolutionChipPanel">
            <appControls:WrapPanel Spacing="{StaticResource Space8}" />
        </ItemsPanelTemplate>
        <Style x:Key="ResolutionChipStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="{StaticResource Space12}" MaxWidth="1160" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="Settings_Title" Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock x:Uid="Settings_Subtitle" Style="{StaticResource SettingsIntroStyle}" Margin="0" />
            <!-- Finds a setting on any tab: the same index the Ctrl+K palette uses. -->
            <AutoSuggestBox x:Name="SettingsSearch" x:Uid="Settings_Search" Width="360" MaxWidth="480" HorizontalAlignment="Left"
                            Margin="0,6,0,0" QueryIcon="Find" AutomationProperties.AutomationId="SettingsSearch"
                            DisplayMemberPath="Display" TextMemberPath="Label"
                            TextChanged="SettingsSearch_TextChanged"
                            QuerySubmitted="SettingsSearch_QuerySubmitted" />
            <InfoBar x:Uid="Settings_SaveError" IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                     IsClosable="False" Severity="Error" AutomationProperties.AutomationId="SettingsSaveError">
                <InfoBar.ActionButton>
                    <Button x:Uid="Settings_RetrySave" Command="{x:Bind ViewModel.SaveConfigCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Categories on the left, one shown at a time. Narrow windows swap the list
             for a drop-down above the content (code-behind, by width). -->
        <Grid x:Name="SettingsBody" Grid.Row="1" ColumnSpacing="24" SizeChanged="SettingsBody_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ListView x:Name="SettingsCategories" Grid.RowSpan="2" Margin="-4,12,0,0" SelectionMode="Single"
                      x:Uid="Settings_Categories"
                      AutomationProperties.AutomationId="SettingsCategories"
                      SelectionChanged="SettingsCategories_SelectionChanged" />
            <ComboBox x:Name="SettingsCategoryPicker" Grid.Column="1" Margin="0,8,0,0" MinWidth="200"
                      x:Uid="Settings_CategoryPicker" Visibility="Collapsed"
                      AutomationProperties.AutomationId="SettingsCategoryPicker"
                      SelectionChanged="SettingsCategoryPicker_SelectionChanged" />
            <Grid x:Name="SettingsTabs" Grid.Column="1" Grid.Row="1">

            <!-- General Tab -->
            <appControls:SettingsTab x:Uid="Settings_TabGeneral" Glyph="{StaticResource GlyphSettings}">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="{StaticResource Space8}">

                        <!-- Display Section -->
                        <TextBlock
                            x:Uid="Settings_DisplayHeader"
                            Margin="1,0,0,4"
                            Style="{StaticResource SectionTitleTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Uid="SC_ShowFileNames"
                            AutomationProperties.AutomationId="SettingsShowFileNamesCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{StaticResource GlyphThumbnail}" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsShowFileNamesToggle"
                                IsOn="{x:Bind ViewModel.ShowFileNames, Mode=TwoWay}" />
                        </controls:SettingsCard>


                        <controls:SettingsCard
                            x:Uid="SC_RatingSource"
                            AutomationProperties.AutomationId="SettingsRatingSourceCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{StaticResource GlyphRating}" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                MinWidth="160"
                                AutomationProperties.AutomationId="SettingsRatingSourceCombo"
                                SelectedIndex="{x:Bind ViewModel.RatingSourceIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="Settings_RatingSourcePlatform" />
                                <ComboBoxItem x:Uid="Settings_RatingSourceUser" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <!--  The app-wide rating filter on or off. The choice itself is
                              made in the title bar; off hides that control and shows
                              every rating, and keeps the choice for when it is on again.  -->
                        <controls:SettingsCard
                            x:Uid="SC_RatingFilterEnabled"
                            AutomationProperties.AutomationId="SettingsRatingFilterCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{StaticResource GlyphFilter}" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsRatingFilterToggle"
                                IsOn="{x:Bind ViewModel.RatingFilterEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_ScrollToTop"
                            AutomationProperties.AutomationId="SettingsScrollToTopCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{StaticResource GlyphSortAscending}" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsScrollToTopToggle"
                                IsOn="{x:Bind ViewModel.ScrollToTopOnSort, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_DiscoverySpread"
                            AutomationProperties.AutomationId="SettingsDiscoverySpreadCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8B3;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsDiscoverySpreadToggle"
                                IsOn="{x:Bind ViewModel.DiscoverySpreadEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_PokerHand"
                            AutomationProperties.AutomationId="SettingsPokerHandCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8EF;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsPokerHandToggle"
                                IsOn="{x:Bind ViewModel.PokerHandEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_GroupCollapseAnimation"
                            AutomationProperties.AutomationId="SettingsGroupCollapseAnimationCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{StaticResource GlyphScene}" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsGroupCollapseAnimationToggle"
                                IsOn="{x:Bind ViewModel.GroupCollapseAnimationEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_AuthorLiveTiles"
                            AutomationProperties.AutomationId="SettingsAuthorLiveTilesCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A9;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsAuthorLiveTilesToggle"
                                IsOn="{x:Bind ViewModel.AuthorLiveTilesEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <!-- Navigation Visibility Section -->
                        <TextBlock
                            x:Uid="Settings_NavigationHeader"
                            Margin="1,12,0,4"
                            Style="{StaticResource SectionTitleTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Uid="SC_Navigation"
                            AutomationProperties.AutomationId="SettingsNavigationCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE700;" />
                            </controls:SettingsCard.HeaderIcon>
                            <appControls:WrapPanel Spacing="{StaticResource Space12}" MaxWidth="540">
                                <CheckBox
                                    x:Uid="Settings_ShowGalleryNav"
                                    IsChecked="{x:Bind ViewModel.ShowGalleryNav, Mode=TwoWay}" />
                                <CheckBox
                                    x:Uid="Settings_ShowCharactersNav"
                                    IsChecked="{x:Bind ViewModel.ShowCharactersNav, Mode=TwoWay}" />
                                <CheckBox
                                    x:Uid="Settings_ShowCoordinatesNav"
                                    IsChecked="{x:Bind ViewModel.ShowCoordinatesNav, Mode=TwoWay}" />
                            </appControls:WrapPanel>
                        </controls:SettingsCard>

                        <!-- Language Section -->
                        <TextBlock
                            x:Uid="Settings_LanguageHeader"
                            Margin="1,12,0,4"
                            Style="{StaticResource SectionTitleTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Uid="SC_Language"
                            AutomationProperties.AutomationId="SettingsLanguageCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{StaticResource GlyphWeb}" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="LanguageComboBox"
                                AutomationProperties.AutomationId="SettingsLanguageComboBox"
                                MinWidth="200"
                                SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="Settings_LanguageSystem" Tag="" />
                                <ComboBoxItem Content="English" Tag="en-US" />
                                <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <InfoBar
                            x:Uid="Settings_RestartInfo"
                            Margin="0,4,0,0"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.ShowRestartHint, Mode=OneWay}"
                            Severity="Informational">
                            <InfoBar.ActionButton>
                                <Button x:Uid="Settings_RestartButton" Click="RestartApp_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                    </StackPanel>
                </ScrollViewer>
            </appControls:SettingsTab>

            <!-- Folders Tab -->
            <appControls:SettingsTab x:Uid="Settings_TabFolders" Glyph="{StaticResource GlyphFolder}">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="{StaticResource Space8}">

                        <TextBlock x:Uid="Settings_FoldersIntro" Style="{StaticResource SettingsIntroStyle}" />
                        <!-- Scene Folders -->
                        <Border Padding="16" CornerRadius="{StaticResource OverlayCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="{StaticResource Space8}">
                                <Grid ColumnSpacing="{StaticResource Space12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_FoldersHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.FolderPaths.Count, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.AddFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                            <FontIcon FontSize="16" Glyph="&#xE8DA;" />
                                            <TextBlock x:Uid="Settings_AddFolder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Uid="Settings_FoldersDesc" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView
                                    x:Name="FolderListView"
                                    ItemsSource="{x:Bind ViewModel.FolderPaths, Mode=OneWay}"
                                    ItemContainerStyle="{StaticResource SettingsListItemStyle}"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Padding="0,2" ColumnSpacing="{StaticResource Space12}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{StaticResource GlyphFolder}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind}" />
                                                <Button x:Uid="Settings_RemoveFolder" Grid.Column="2" VerticalAlignment="Center" CommandParameter="{x:Bind}" Click="RemoveFolder_Click" Style="{StaticResource SubtleButtonStyle}">
                                                    <FontIcon FontSize="{StaticResource IconSize}" Glyph="{StaticResource GlyphDelete}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Uid="Settings_NoFolders" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.HasNoFolders, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Character Card Folders -->
                        <Border Padding="16" CornerRadius="{StaticResource OverlayCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="{StaticResource Space8}">
                                <Grid ColumnSpacing="{StaticResource Space12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_CharaFoldersHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.CharacterFolderPaths.Count, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.AddCharacterFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                            <FontIcon FontSize="16" Glyph="&#xE8DA;" />
                                            <TextBlock x:Uid="Settings_AddFolder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Uid="Settings_CharaFoldersDesc" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView
                                    x:Name="CharacterFolderListView"
                                    ItemsSource="{x:Bind ViewModel.CharacterFolderPaths, Mode=OneWay}"
                                    ItemContainerStyle="{StaticResource SettingsListItemStyle}"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Padding="0,2" ColumnSpacing="{StaticResource Space12}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{StaticResource GlyphFolder}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind}" />
                                                <Button x:Uid="Settings_RemoveFolder" Grid.Column="2" VerticalAlignment="Center" CommandParameter="{x:Bind}" Click="RemoveCharacterFolder_Click" Style="{StaticResource SubtleButtonStyle}">
                                                    <FontIcon FontSize="{StaticResource IconSize}" Glyph="{StaticResource GlyphDelete}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Uid="Settings_NoFolders" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.HasNoCharacterFolders, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Coordinate Card Folders -->
                        <Border Padding="16" CornerRadius="{StaticResource OverlayCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="{StaticResource Space8}">
                                <Grid ColumnSpacing="{StaticResource Space12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_CoordFoldersHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.CoordinateFolderPaths.Count, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.AddCoordinateFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                            <FontIcon FontSize="16" Glyph="&#xE8DA;" />
                                            <TextBlock x:Uid="Settings_AddFolder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Uid="Settings_CoordFoldersDesc" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView
                                    x:Name="CoordinateFolderListView"
                                    ItemsSource="{x:Bind ViewModel.CoordinateFolderPaths, Mode=OneWay}"
                                    ItemContainerStyle="{StaticResource SettingsListItemStyle}"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Padding="0,2" ColumnSpacing="{StaticResource Space12}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{StaticResource GlyphFolder}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind}" />
                                                <Button x:Uid="Settings_RemoveFolder" Grid.Column="2" VerticalAlignment="Center" CommandParameter="{x:Bind}" Click="RemoveCoordinateFolder_Click" Style="{StaticResource SubtleButtonStyle}">
                                                    <FontIcon FontSize="{StaticResource IconSize}" Glyph="{StaticResource GlyphDelete}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Uid="Settings_NoFolders" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.HasNoCoordinateFolders, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Mods Section -->
                        <TextBlock
                            x:Uid="Settings_ModsHeader"
                            Margin="1,20,0,4"
                            Style="{StaticResource SectionTitleTextBlockStyle}" />

                        <controls:SettingsCard x:Uid="SC_KoikatsuGameFolder">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7FC;" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Spacing="6" HorizontalAlignment="Right">
                                <TextBlock MaxWidth="400" IsTextSelectionEnabled="True" TextWrapping="Wrap" HorizontalAlignment="Right"
                                           Text="{x:Bind ViewModel.KoikatsuGameFolderDisplay, Mode=OneWay}" />
                                <TextBlock MaxWidth="400" TextWrapping="Wrap" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Text="{x:Bind ViewModel.KoikatsuGameFolderStatus, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" HorizontalAlignment="Right">
                                    <Button x:Uid="Settings_Mods_Pick" Command="{x:Bind ViewModel.PickKoikatsuGameFolderCommand}" />
                                    <Button x:Uid="Settings_Mods_Clear" Command="{x:Bind ViewModel.ClearKoikatsuGameFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="SC_KoikatsuSunshineGameFolder">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7FC;" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Spacing="6" HorizontalAlignment="Right">
                                <TextBlock MaxWidth="400" IsTextSelectionEnabled="True" TextWrapping="Wrap" HorizontalAlignment="Right"
                                           Text="{x:Bind ViewModel.KoikatsuSunshineGameFolderDisplay, Mode=OneWay}" />
                                <TextBlock MaxWidth="400" TextWrapping="Wrap" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Text="{x:Bind ViewModel.KoikatsuSunshineGameFolderStatus, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" HorizontalAlignment="Right">
                                    <Button x:Uid="Settings_Mods_Pick" Command="{x:Bind ViewModel.PickKoikatsuSunshineGameFolderCommand}" />
                                    <Button x:Uid="Settings_Mods_Clear" Command="{x:Bind ViewModel.ClearKoikatsuSunshineGameFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="SC_ModInstallFolderName">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{StaticResource GlyphFolder}" />
                            </controls:SettingsCard.HeaderIcon>
                            <TextBox MinWidth="200" Text="{x:Bind ViewModel.ModInstallFolderName, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <!-- Moves the whole library to the three-level layout; nothing moves before the dialog's confirm. -->
                        <controls:SettingsCard x:Uid="SC_LayoutMigration" AutomationProperties.AutomationId="SettingsLayoutMigrationCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8DE;" />
                            </controls:SettingsCard.HeaderIcon>
                            <Button x:Uid="SC_LayoutMigrationButton" AutomationProperties.AutomationId="SettingsLayoutMigrationButton" Click="LayoutMigration_Click" />
                        </controls:SettingsCard>


                    </StackPanel>
                </ScrollViewer>
            </appControls:SettingsTab>

            <!-- Filters Tab -->
            <appControls:SettingsTab x:Uid="Settings_TabFilters" Glyph="{StaticResource GlyphFilter}">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="{StaticResource Space8}">
                        <TextBlock x:Uid="Settings_SizeFiltersHeader" Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock x:Uid="Settings_FiltersIntro" Style="{StaticResource SettingsIntroStyle}" />
                        <Border Style="{StaticResource FilterCardStyle}">
                            <StackPanel Spacing="{StaticResource Space12}">
                                <Grid ColumnSpacing="{StaticResource Space12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{StaticResource GlyphThumbnail}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space4}" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_SceneResolutionHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind GetResolutionFilterSummary(ViewModel.ResolutionFilterEnabled, ViewModel.AllowedResolutions.Count), Mode=OneWay}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   AutomationProperties.AutomationId="SettingsSceneFilterSummary" />
                                    </StackPanel>
                                    <ToggleSwitch x:Uid="Settings_SceneFilterToggle" Grid.Column="2" VerticalAlignment="Center"
                                                  IsOn="{x:Bind ViewModel.ResolutionFilterEnabled, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="SettingsSceneFilterToggle"
                                                  OnContent="" OffContent="" MinWidth="0" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AllowedResolutions, Mode=OneWay}"
                                              IsEnabled="{x:Bind ViewModel.ResolutionFilterEnabled, Mode=OneWay}"
                                              ItemsPanel="{StaticResource ResolutionChipPanel}"
                                              AutomationProperties.AutomationId="SettingsSceneResolutionChips">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Click="RemoveResolution_Click" CommandParameter="{x:Bind}"
                                                    Style="{StaticResource ResolutionChipStyle}"
                                                    AutomationProperties.Name="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}"
                                                    ToolTipService.ToolTip="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind}" />
                                                    <FontIcon Glyph="{StaticResource GlyphRemove}" FontSize="10" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="{StaticResource Space8}" Visibility="{x:Bind ViewModel.ResolutionFilterEnabled, Mode=OneWay}">
                                    <Grid ColumnSpacing="{StaticResource Space8}" HorizontalAlignment="Left" MaxWidth="360">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ResolutionInput" x:Uid="Settings_ResolutionInput" MinWidth="140"
                                                 KeyDown="ResolutionInput_KeyDown" TextChanged="ResolutionInput_TextChanged" />
                                        <Button x:Uid="Settings_AddSize" Grid.Column="1" Click="AddResolution_Click" />
                                    </Grid>
                                    <TextBlock x:Name="ResolutionError" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FilterCardStyle}">
                            <StackPanel Spacing="{StaticResource Space12}">
                                <Grid ColumnSpacing="{StaticResource Space12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{StaticResource GlyphCharacter}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space4}" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_CharaResolutionHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind GetResolutionFilterSummary(ViewModel.CharacterResolutionFilterEnabled, ViewModel.CharacterAllowedResolutions.Count), Mode=OneWay}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   AutomationProperties.AutomationId="SettingsCharaFilterSummary" />
                                    </StackPanel>
                                    <ToggleSwitch x:Uid="Settings_CharaFilterToggle" Grid.Column="2" VerticalAlignment="Center"
                                                  IsOn="{x:Bind ViewModel.CharacterResolutionFilterEnabled, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="SettingsCharaFilterToggle"
                                                  OnContent="" OffContent="" MinWidth="0" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CharacterAllowedResolutions, Mode=OneWay}"
                                              IsEnabled="{x:Bind ViewModel.CharacterResolutionFilterEnabled, Mode=OneWay}"
                                              ItemsPanel="{StaticResource ResolutionChipPanel}"
                                              AutomationProperties.AutomationId="SettingsCharaResolutionChips">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Click="RemoveCharacterResolution_Click" CommandParameter="{x:Bind}"
                                                    Style="{StaticResource ResolutionChipStyle}"
                                                    AutomationProperties.Name="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}"
                                                    ToolTipService.ToolTip="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind}" />
                                                    <FontIcon Glyph="{StaticResource GlyphRemove}" FontSize="10" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="{StaticResource Space8}" Visibility="{x:Bind ViewModel.CharacterResolutionFilterEnabled, Mode=OneWay}">
                                    <Grid ColumnSpacing="{StaticResource Space8}" HorizontalAlignment="Left" MaxWidth="360">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CharacterResolutionInput" x:Uid="Settings_CharaResolutionInput" MinWidth="140"
                                                 KeyDown="CharacterResolutionInput_KeyDown" TextChanged="ResolutionInput_TextChanged" />
                                        <Button x:Uid="Settings_AddSize" Grid.Column="1" Click="AddCharacterResolution_Click" />
                                    </Grid>
                                    <TextBlock x:Name="CharacterResolutionError" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FilterCardStyle}">
                            <StackPanel Spacing="{StaticResource Space12}">
                                <Grid ColumnSpacing="{StaticResource Space12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space4}" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Settings_CoordResolutionHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind GetResolutionFilterSummary(ViewModel.CoordinateResolutionFilterEnabled, ViewModel.CoordinateAllowedResolutions.Count), Mode=OneWay}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   AutomationProperties.AutomationId="SettingsCoordFilterSummary" />
                                    </StackPanel>
                                    <ToggleSwitch x:Uid="Settings_CoordFilterToggle" Grid.Column="2" VerticalAlignment="Center"
                                                  IsOn="{x:Bind ViewModel.CoordinateResolutionFilterEnabled, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="SettingsCoordFilterToggle"
                                                  OnContent="" OffContent="" MinWidth="0" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CoordinateAllowedResolutions, Mode=OneWay}"
                                              IsEnabled="{x:Bind ViewModel.CoordinateResolutionFilterEnabled, Mode=OneWay}"
                                              ItemsPanel="{StaticResource ResolutionChipPanel}"
                                              AutomationProperties.AutomationId="SettingsCoordResolutionChips">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Click="RemoveCoordinateResolution_Click" CommandParameter="{x:Bind}"
                                                    Style="{StaticResource ResolutionChipStyle}"
                                                    AutomationProperties.Name="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}"
                                                    ToolTipService.ToolTip="{x:Bind local:SettingsPage.GetRemoveResolutionLabel((x:String))}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind}" />
                                                    <FontIcon Glyph="{StaticResource GlyphRemove}" FontSize="10" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="{StaticResource Space8}" Visibility="{x:Bind ViewModel.CoordinateResolutionFilterEnabled, Mode=OneWay}">
                                    <Grid ColumnSpacing="{StaticResource Space8}" HorizontalAlignment="Left" MaxWidth="360">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CoordinateResolutionInput" x:Uid="Settings_CoordResolutionInput" MinWidth="140"
                                                 KeyDown="CoordinateResolutionInput_KeyDown" TextChanged="ResolutionInput_TextChanged" />
                                        <Button x:Uid="Settings_AddSize" Grid.Column="1" Click="AddCoordinateResolution_Click" />
                                    </Grid>
                                    <TextBlock x:Name="CoordinateResolutionError" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Uid="Settings_SceneTagsHeader" Margin="0,20,0,4" Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <Border Style="{StaticResource FilterCardStyle}">
                            <StackPanel Spacing="{StaticResource Space12}">
                                <Grid ColumnSpacing="{StaticResource Space12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEA86;" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space4}">
                                        <TextBlock x:Uid="Settings_PluginHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind GetPluginAnalysisSummary(ViewModel.PluginAnalysisEnabled), Mode=OneWay}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Uid="Settings_PluginAnalysisToggle" Grid.Column="2" VerticalAlignment="Center"
                                                  IsOn="{x:Bind ViewModel.PluginAnalysisEnabled, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="SettingsPluginAnalysisToggle" OnContent="" OffContent="" MinWidth="0" />
                                </Grid>
                                <TextBlock x:Uid="Settings_PluginDesc" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Spacing="{StaticResource Space12}">
                                    <appControls:WrapPanel Spacing="{StaticResource Space8}">
                                        <Button
                                            Command="{x:Bind ViewModel.ScanMissingMetadataCommand}"
                                            IsEnabled="{x:Bind CanScanMetadata(ViewModel.PluginAnalysisEnabled, GalleryViewModel.IsNotParsingMetadata), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                                <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE895;" />
                                                <TextBlock x:Uid="Settings_ScanMissing" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Command="{x:Bind ViewModel.RescanMetadataCommand}"
                                            IsEnabled="{x:Bind CanScanMetadata(ViewModel.PluginAnalysisEnabled, GalleryViewModel.IsNotParsingMetadata), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                                <FontIcon FontSize="{StaticResource IconSize}" Glyph="{StaticResource GlyphRefresh}" />
                                                <TextBlock x:Uid="Settings_RescanAll" />
                                            </StackPanel>
                                        </Button>
                                    </appControls:WrapPanel>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource Space8}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind GalleryViewModel.IsParsingMetadata, Mode=OneWay}">
                                        <ProgressRing Width="{StaticResource RingSize}" Height="{StaticResource RingSize}" IsActive="True" />
                                        <TextBlock x:Uid="Settings_ScanProgress" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind GalleryViewModel.PendingMetadataCount, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </appControls:SettingsTab>

            <!-- Advanced Tab -->
            <appControls:SettingsTab x:Uid="Settings_TabAdvanced" Glyph="&#xE9F5;">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="{StaticResource Space8}">

                        <!-- Cache Section -->
                        <TextBlock
                            x:Uid="Settings_CacheHeader"
                            Margin="1,0,0,4"
                            Style="{StaticResource SectionTitleTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Uid="SC_CacheFolder"
                            AutomationProperties.AutomationId="SettingsCacheFolderCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{StaticResource GlyphFolder}" />
                            </controls:SettingsCard.HeaderIcon>
                            <TextBlock
                                MaxWidth="400"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CacheFolderDisplay, Mode=OneWay}"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind ViewModel.CacheFolderDisplay, Mode=OneWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_CacheUsage">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7F1;" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Spacing="{StaticResource Space8}">
                                <TextBlock Text="{x:Bind ViewModel.CacheUsageText, Mode=OneWay}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Button x:Uid="Settings_RefreshCache" Command="{x:Bind ViewModel.RefreshCacheUsageCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanManageCache, Mode=OneWay}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Uid="SC_CacheActions"
                            IsEnabled="{x:Bind ViewModel.CanManageCache, Mode=OneWay}"
                            AutomationProperties.AutomationId="SettingsCacheActionsCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE90F;" />
                            </controls:SettingsCard.HeaderIcon>
                            <appControls:WrapPanel Spacing="{StaticResource Space8}">
                                <Button Command="{x:Bind ViewModel.ChangeCacheFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE8DA;" />
                                        <TextBlock x:Uid="Settings_ChangeFolder" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ResetCacheFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE777;" />
                                        <TextBlock x:Uid="Settings_ResetDefault" />
                                    </StackPanel>
                                </Button>
                                <Button Click="ClearCache_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="{StaticResource GlyphDelete}" />
                                        <TextBlock x:Uid="Settings_ClearCache" />
                                    </StackPanel>
                                </Button>
                            </appControls:WrapPanel>
                        </controls:SettingsCard>

                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{x:Bind ViewModel.IsCacheBusy, Mode=OneWay}" />
                        <InfoBar IsOpen="{x:Bind ViewModel.HasCacheResult, Mode=OneWay}" IsClosable="False"
                                 Severity="{x:Bind ViewModel.CacheResultSeverity, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.CacheResultMessage, Mode=OneWay}"
                                 AutomationProperties.AutomationId="SettingsCacheResult" />

                        <!-- Cache Buffer Section -->
                        <TextBlock
                            x:Uid="Settings_AdvancedHeader"
                            Margin="1,28,0,4"
                            Style="{StaticResource SectionTitleTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Uid="SC_CacheBuffer"
                            AutomationProperties.AutomationId="SettingsCacheBufferCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7F8;" />
                            </controls:SettingsCard.HeaderIcon>
                            <NumberBox
                                AutomationProperties.AutomationId="SettingsCacheBufferNumberBox"
                                MinWidth="160"
                                LargeChange="4"
                                Maximum="40"
                                Minimum="2"
                                SmallChange="2"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.CacheLength, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <InfoBar
                            x:Uid="Settings_CacheBufferWarning"
                            Margin="0,4,0,0"
                            IsClosable="False"
                            IsOpen="True"
                            Severity="Warning" />

                    </StackPanel>
                </ScrollViewer>
            </appControls:SettingsTab>

            <!-- Plugins Tab -->
            <appControls:SettingsTab x:Uid="Settings_TabPlugins" Glyph="&#xEA86;">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="20">

                        <!-- Overview -->
                        <StackPanel Spacing="{StaticResource Space16}">
                            <TextBlock
                                x:Uid="Plugins_Header"
                                Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Plugins_Desc"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <InfoBar
                                x:Uid="Plugins_RiskWarning"
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Warning" />
                        </StackPanel>

                        <!-- Installed Plugins -->
                        <StackPanel Spacing="{StaticResource Space16}">
                            <Button Click="OpenPluginsFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                    <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE8DA;" />
                                    <TextBlock x:Uid="Plugins_OpenFolder" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                x:Uid="Plugins_RestartNote"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock
                                x:Uid="Plugins_Empty"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind HasNoPlugins}" />

                            <ItemsControl ItemsSource="{x:Bind PluginItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:PluginListItem">
                                        <Button
                                            Margin="0,0,0,8"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="PluginItem_Click"
                                            CommandParameter="{x:Bind}">
                                            <Grid
                                                Padding="16,12"
                                                ColumnSpacing="{StaticResource Space12}"
                                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xEA86;" />

                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="{x:Bind Name}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Version}"
                                                            Visibility="{x:Bind HasVersion}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Description}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind HasDescription}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Error}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind HasError}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind UpdateText}"
                                                        Visibility="{x:Bind UpdateAvailable}" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind StatusText}" />

                                                <FontIcon
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="{StaticResource GlyphNext}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                        <!-- Install Instructions -->
                        <Expander x:Uid="Plugins_InstallHelp" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <StackPanel Spacing="{StaticResource Space8}">
                                <TextBlock
                                    x:Uid="Plugins_InstallStepDownload"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="Plugins_InstallStepCopy"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="Plugins_InstallStepRestart"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </appControls:SettingsTab>

            <!-- Experimental Tab -->
            <appControls:SettingsTab x:Uid="Settings_TabOcd" Glyph="&#xE7BE;">
                <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
                    <StackPanel Spacing="{StaticResource Space8}">

                        <InfoBar
                            x:Uid="Settings_OcdDesc"
                            Margin="0,0,0,12"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Warning" />

                        <controls:SettingsCard
                            x:Uid="SC_VisualSimilarity"
                            AutomationProperties.AutomationId="SettingsVisualSimilarityCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsVisualSimilarityToggle"
                                IsOn="{x:Bind ViewModel.UseVisualSimilarity, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <!--  The library's thumbnail size: it was a switch in the library's
                              toolbar, and in use it was hardly ever touched (user).  -->
                        <controls:SettingsCard
                            x:Uid="SC_ThumbnailSize"
                            AutomationProperties.AutomationId="SettingsThumbnailSizeCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{StaticResource GlyphThumbnail}" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                MinWidth="160"
                                AutomationProperties.AutomationId="SettingsThumbnailSizeCombo"
                                SelectedIndex="{x:Bind ViewModel.ThumbnailSizeIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="Gallery_ThumbnailSizeSmall" />
                                <ComboBoxItem x:Uid="Gallery_ThumbnailSizeMedium" />
                                <ComboBoxItem x:Uid="Gallery_ThumbnailSizeLarge" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <!--  Square corners everywhere: the corner radius resources are
                              set to zero at start (App.ApplyCornerStyle), so it takes
                              effect after a restart.  -->
                        <controls:SettingsCard
                            x:Uid="SC_SquareCorners"
                            AutomationProperties.AutomationId="SettingsSquareCornersCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE71A;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsSquareCornersToggle"
                                IsOn="{x:Bind ViewModel.SquareCorners, Mode=TwoWay}" />
                        </controls:SettingsCard>

                    </StackPanel>
                </ScrollViewer>
            </appControls:SettingsTab>

            </Grid>
        </Grid>
    </Grid>
</Page>

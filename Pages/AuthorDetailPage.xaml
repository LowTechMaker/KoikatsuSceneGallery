<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.AuthorDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KoikatsuSceneGallery.Controls"
    xmlns:converters="using:KoikatsuSceneGallery.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KoikatsuSceneGallery.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KoikatsuSceneGallery.Models"
    xmlns:viewModels="using:KoikatsuSceneGallery.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DataTemplate x:Key="UnassignedAuthorImageTemplate" x:DataType="models:UnassignedAuthorImage">
            <Grid Margin="0,2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Height="64"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Image
                        Stretch="UniformToFill"
                        Source="{x:Bind local:AuthorDetailPage.CreatePostThumbnail(ImageUri)}" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind FileName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind FileName}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="{StaticResource Space16}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Author Header -->
        <Grid ColumnSpacing="{StaticResource Space16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <PersonPicture
                Width="64"
                Height="64"
                DisplayName="{x:Bind ViewModel.Author.Name, Mode=OneWay}"
                ProfilePicture="{x:Bind ViewModel.Author.AvatarSource, Mode=OneWay}" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="{StaticResource Space4}">
                <TextBlock
                    Style="{StaticResource PageTitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Author.Name, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" Visibility="{x:Bind ViewModel.HasScenes, Mode=OneWay}">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B9;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SceneCount, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" Visibility="{x:Bind ViewModel.HasCharacters, Mode=OneWay}">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE77B;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.CharacterCount, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" Visibility="{x:Bind ViewModel.HasCoordinates, Mode=OneWay}">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE78A;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.CoordinateCount, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource Space8}">
                <Button
                    x:Uid="AuthorDetail_OpenProfile"
                    AutomationProperties.AutomationId="AuthorOpenProfileButton"
                    Click="OpenProfile_Click"
                    Visibility="{x:Bind ViewModel.HasProfileUrl, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE774;" />
                        <TextBlock x:Uid="AuthorDetail_OpenProfileLabel" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="AuthorDetail_EditLocal"
                    AutomationProperties.AutomationId="AuthorEditLocalButton"
                    Click="EditLocal_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsLocalSource, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE70F;" />
                        <TextBlock x:Uid="AuthorDetail_EditLocalLabel" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="AuthorDetail_Shuffle"
                    AutomationProperties.AutomationId="AuthorShuffleButton"
                    Click="Shuffle_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE8B1;" />
                        <TextBlock x:Uid="AuthorDetail_ShuffleLabel" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="AuthorDetail_Refresh"
                    AutomationProperties.AutomationId="AuthorRefreshButton"
                    Click="Refresh_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE72C;" />
                        <TextBlock x:Uid="AuthorDetail_RefreshLabel" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tabs: Scenes / Characters / Coordinates -->
        <Pivot x:Name="TabPivot" AutomationProperties.AutomationId="AuthorTabPivot" Grid.Row="1">

            <!-- Overview keeps every kind visible instead of privileging scenes. -->
            <PivotItem x:Name="OverviewPivotItem">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE80F;" />
                        <TextBlock x:Uid="AuthorDetail_OverviewTab" />
                    </StackPanel>
                </PivotItem.Header>
                <!--  Wave 17: each section wraps onto at most two lines (the view
                      model fills what fits) instead of one row scrolling sideways.  -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OverviewContent" Margin="0,8,0,16" Spacing="20" SizeChanged="OverviewContent_SizeChanged">
                        <StackPanel Spacing="{StaticResource Space8}" Visibility="{x:Bind ViewModel.HasScenes, Mode=OneWay}">
                            <Grid>
                                <TextBlock x:Uid="AuthorDetail_ScenesTab" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <HyperlinkButton Grid.Column="1" HorizontalAlignment="Right" Tag="1" Click="OverviewSection_Click" Padding="0">
                                    <TextBlock x:Uid="AuthorDetail_ViewAll" />
                                </HyperlinkButton>
                            </Grid>
                            <GridView ItemsSource="{x:Bind ViewModel.ScenePreviews}" IsItemClickEnabled="True" ItemClick="ScenesGrid_ItemClick" CanDragItems="True" DragItemsStarting="OverviewScenes_DragItemsStarting" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <GridView.ItemsPanel><ItemsPanelTemplate><controls:WrapPanel Spacing="{StaticResource Space8}" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate><DataTemplate x:DataType="models:SceneCard"><Grid Width="{x:Bind local:AuthorDetailPage.GetPreviewWidth(Width, Height, 132)}" Height="132"><Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image Stretch="Uniform" Source="{x:Bind local:AuthorDetailPage.CreateThumbnail(ThumbnailUri), Mode=OneWay}" /></Border></Grid></DataTemplate></GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource Space8}" Visibility="{x:Bind ViewModel.HasCharacters, Mode=OneWay}">
                            <Grid><TextBlock x:Uid="AuthorDetail_CharactersTab" Style="{StaticResource SectionTitleTextBlockStyle}" /><HyperlinkButton HorizontalAlignment="Right" Tag="2" Click="OverviewSection_Click" Padding="0"><TextBlock x:Uid="AuthorDetail_ViewAll" /></HyperlinkButton></Grid>
                            <GridView ItemsSource="{x:Bind ViewModel.CharacterPreviews}" IsItemClickEnabled="True" ItemClick="CharactersGrid_ItemClick" CanDragItems="True" DragItemsStarting="OverviewCharacters_DragItemsStarting" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <GridView.ItemsPanel><ItemsPanelTemplate><controls:WrapPanel Spacing="{StaticResource Space8}" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate><DataTemplate x:DataType="models:CharacterCard"><Grid Width="{x:Bind local:AuthorDetailPage.GetPreviewWidth(Width, Height, 132)}" Height="132"><Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image Stretch="Uniform" Source="{x:Bind local:AuthorDetailPage.CreateThumbnail(ThumbnailUri), Mode=OneWay}" /></Border></Grid></DataTemplate></GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource Space8}" Visibility="{x:Bind ViewModel.HasCoordinates, Mode=OneWay}">
                            <Grid><TextBlock x:Uid="AuthorDetail_CoordinatesTab" Style="{StaticResource SectionTitleTextBlockStyle}" /><HyperlinkButton HorizontalAlignment="Right" Tag="3" Click="OverviewSection_Click" Padding="0"><TextBlock x:Uid="AuthorDetail_ViewAll" /></HyperlinkButton></Grid>
                            <GridView ItemsSource="{x:Bind ViewModel.CoordinatePreviews}" IsItemClickEnabled="True" ItemClick="CoordinatesGrid_ItemClick" CanDragItems="True" DragItemsStarting="OverviewCoordinates_DragItemsStarting" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <GridView.ItemsPanel><ItemsPanelTemplate><controls:WrapPanel Spacing="{StaticResource Space8}" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate><DataTemplate x:DataType="models:CoordinateCard"><Grid Width="{x:Bind local:AuthorDetailPage.GetPreviewWidth(Width, Height, 132)}" Height="132"><Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image Stretch="Uniform" Source="{x:Bind local:AuthorDetailPage.CreateThumbnail(ThumbnailUri), Mode=OneWay}" /></Border></Grid></DataTemplate></GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource Space8}" Visibility="{x:Bind ViewModel.HasPosts, Mode=OneWay}">
                            <Grid><TextBlock x:Uid="AuthorDetail_PostsTab" Style="{StaticResource SectionTitleTextBlockStyle}" /><HyperlinkButton HorizontalAlignment="Right" Tag="4" Click="OverviewSection_Click" Padding="0"><TextBlock x:Uid="AuthorDetail_ViewAll" /></HyperlinkButton></Grid>
                            <GridView ItemsSource="{x:Bind ViewModel.PostPreviews}" IsItemClickEnabled="True" ItemClick="OverviewPost_ItemClick" CanDragItems="True" DragItemsStarting="OverviewPosts_DragItemsStarting" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <GridView.ItemsPanel><ItemsPanelTemplate><controls:WrapPanel Spacing="{StaticResource Space8}" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate><DataTemplate x:DataType="viewModels:PostImageGroupViewModel"><Grid Width="{x:Bind local:AuthorDetailPage.GetPreviewWidth(CoverAspectRatio, 132)}" Height="132"><Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image Stretch="Uniform" Source="{x:Bind local:AuthorDetailPage.CreatePostThumbnail(CoverImageUri), Mode=OneTime}" /></Border></Grid></DataTemplate></GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Scenes Tab -->
            <PivotItem x:Name="ScenesPivotItem">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE8B9;" />
                        <TextBlock x:Uid="AuthorDetail_ScenesTab" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind local:AuthorDetailPage.FormatCount(ViewModel.SceneCount), Mode=OneWay}" />
                    </StackPanel>
                </PivotItem.Header>
                <controls:LibraryBrowser x:Name="ScenesBrowser" />
            </PivotItem>

            <!-- Characters Tab -->
            <PivotItem x:Name="CharactersPivotItem">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE77B;" />
                        <TextBlock x:Uid="AuthorDetail_CharactersTab" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind local:AuthorDetailPage.FormatCount(ViewModel.CharacterCount), Mode=OneWay}" />
                    </StackPanel>
                </PivotItem.Header>
                <controls:LibraryBrowser x:Name="CharactersBrowser" />
            </PivotItem>

            <!-- Coordinates Tab -->
            <PivotItem x:Name="CoordinatesPivotItem">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE78A;" />
                        <TextBlock x:Uid="AuthorDetail_CoordinatesTab" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind local:AuthorDetailPage.FormatCount(ViewModel.CoordinateCount), Mode=OneWay}" />
                    </StackPanel>
                </PivotItem.Header>
                <controls:LibraryBrowser x:Name="CoordinatesBrowser" />
            </PivotItem>

            <!-- Posts Tab (added dynamically for providers with artwork scanning) -->
            <PivotItem x:Name="PostsPivotItem">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE8F1;" />
                        <TextBlock x:Uid="AuthorDetail_PostsTab" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind local:AuthorDetailPage.FormatCount(ViewModel.PostCount), Mode=OneWay}" />
                    </StackPanel>
                </PivotItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Margin="0,8,0,4"
                        Orientation="Horizontal"
                        Spacing="{StaticResource Space12}"
                        Visibility="{x:Bind ViewModel.HasUnassignedImages, Mode=OneWay}">
                        <TextBlock
                            x:Uid="AuthorDetail_UnassignedFiles"
                            VerticalAlignment="Center" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.UnassignedImageCount, Mode=OneWay}" />
                        <Button
                            x:Uid="AuthorDetail_AssignUnclassified"
                            Click="AssignUnclassified_Click" />
                    </StackPanel>
                    <ProgressRing
                        Grid.RowSpan="2"
                        IsActive="{x:Bind ViewModel.IsLoadingPosts, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoadingPosts, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <GridView
                        Grid.Row="1"
                        x:Name="PostsGrid"
                        AutomationProperties.AutomationId="AuthorPostsGrid"
                        Margin="0,8,0,0"
                        IsItemClickEnabled="True"
                        ItemClick="PostsGrid_ItemClick"
                        ItemsSource="{x:Bind ViewModel.PostGroups}"
                        SelectionMode="None">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection />
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="220" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:PostImageGroupViewModel">
                                <Grid Padding="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Image Stretch="UniformToFill" Source="{x:Bind local:AuthorDetailPage.CreatePostThumbnail(CoverImageUri), Mode=OneTime}" />
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource MediaOverlayBadgeStyle}" Margin="8" Visibility="{x:Bind HasAdditionalImages, Mode=OneTime}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}"><FontIcon Glyph="&#xE722;" FontSize="12" Foreground="{ThemeResource MediaOverlayForegroundBrush}" /><TextBlock Text="{x:Bind AdditionalImageCountText, Mode=OneTime}" Foreground="{ThemeResource MediaOverlayForegroundBrush}" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                                    </Border>
                                    <TextBlock Grid.Row="1" Margin="8,6" Text="{x:Bind Post.DisplayTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>

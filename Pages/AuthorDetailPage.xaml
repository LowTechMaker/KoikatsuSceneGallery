<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.AuthorDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KoikatsuSceneGallery.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KoikatsuSceneGallery.Models"
    xmlns:viewModels="using:KoikatsuSceneGallery.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="UnassignedAuthorImageTemplate" x:DataType="models:UnassignedAuthorImage">
            <Grid Margin="0,2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Height="64"
                    CornerRadius="4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Image
                        Stretch="UniformToFill"
                        Source="{x:Bind local:AuthorDetailPage.CreatePostThumbnail(ImageUri)}" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind FileName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind FileName}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Author Header -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Uid="Detail_GoBack"
                VerticalAlignment="Center"
                Click="GoBack_Click"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <PersonPicture
                Grid.Column="1"
                Width="64"
                Height="64"
                DisplayName="{x:Bind ViewModel.Author.Name, Mode=OneWay}"
                ProfilePicture="{x:Bind ViewModel.Author.AvatarSource, Mode=OneWay}" />

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Author.Name, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B9;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SceneCount, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE77B;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.CharacterCount, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE78A;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.CoordinateCount, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Uid="AuthorDetail_OpenProfile"
                    AutomationProperties.AutomationId="AuthorOpenProfileButton"
                    Click="OpenProfile_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE774;" />
                        <TextBlock x:Uid="AuthorDetail_OpenProfileLabel" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="AuthorDetail_Shuffle"
                    AutomationProperties.AutomationId="AuthorShuffleButton"
                    Click="Shuffle_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                </Button>
                <Button
                    x:Uid="AuthorDetail_Refresh"
                    AutomationProperties.AutomationId="AuthorRefreshButton"
                    Click="Refresh_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tabs: Scenes / Characters / Coordinates -->
        <Pivot x:Name="TabPivot" AutomationProperties.AutomationId="AuthorTabPivot" Grid.Row="1">

            <!-- Overview keeps every kind visible instead of privileging scenes. -->
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE80F;" />
                        <TextBlock x:Uid="AuthorDetail_OverviewTab" />
                    </StackPanel>
                </PivotItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OverviewContent" Margin="0,8,0,16" Spacing="20" SizeChanged="OverviewContent_SizeChanged">
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasScenes, Mode=OneWay}">
                            <Grid>
                                <TextBlock x:Uid="AuthorDetail_ScenesTab" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <HyperlinkButton Grid.Column="1" HorizontalAlignment="Right" Tag="1" Click="OverviewSection_Click" Padding="0">
                                    <TextBlock x:Uid="AuthorDetail_ViewAll" />
                                </HyperlinkButton>
                            </Grid>
                            <GridView Height="144" ItemsSource="{x:Bind ViewModel.ScenePreviews}" IsItemClickEnabled="True" ItemClick="ScenesGrid_ItemClick" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate><DataTemplate x:DataType="models:SceneCard"><Grid Width="{x:Bind local:AuthorDetailPage.GetPreviewWidth(Width, Height, 132)}" Height="132" Margin="0,0,8,0"><Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image Stretch="Uniform" Source="{x:Bind local:AuthorDetailPage.CreateThumbnail(ThumbnailUri), Mode=OneWay}" /></Border></Grid></DataTemplate></GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasCharacters, Mode=OneWay}">
                            <Grid><TextBlock x:Uid="AuthorDetail_CharactersTab" Style="{StaticResource SubtitleTextBlockStyle}" /><HyperlinkButton HorizontalAlignment="Right" Tag="2" Click="OverviewSection_Click" Padding="0"><TextBlock x:Uid="AuthorDetail_ViewAll" /></HyperlinkButton></Grid>
                            <GridView Height="144" ItemsSource="{x:Bind ViewModel.CharacterPreviews}" IsItemClickEnabled="True" ItemClick="CharactersGrid_ItemClick" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate><DataTemplate x:DataType="models:CharacterCard"><Grid Width="{x:Bind local:AuthorDetailPage.GetPreviewWidth(Width, Height, 132)}" Height="132" Margin="0,0,8,0"><Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image Stretch="Uniform" Source="{x:Bind local:AuthorDetailPage.CreateThumbnail(ThumbnailUri), Mode=OneWay}" /></Border></Grid></DataTemplate></GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasCoordinates, Mode=OneWay}">
                            <Grid><TextBlock x:Uid="AuthorDetail_CoordinatesTab" Style="{StaticResource SubtitleTextBlockStyle}" /><HyperlinkButton HorizontalAlignment="Right" Tag="3" Click="OverviewSection_Click" Padding="0"><TextBlock x:Uid="AuthorDetail_ViewAll" /></HyperlinkButton></Grid>
                            <GridView Height="144" ItemsSource="{x:Bind ViewModel.CoordinatePreviews}" IsItemClickEnabled="True" ItemClick="CoordinatesGrid_ItemClick" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate><DataTemplate x:DataType="models:CoordinateCard"><Grid Width="{x:Bind local:AuthorDetailPage.GetPreviewWidth(Width, Height, 132)}" Height="132" Margin="0,0,8,0"><Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image Stretch="Uniform" Source="{x:Bind local:AuthorDetailPage.CreateThumbnail(ThumbnailUri), Mode=OneWay}" /></Border></Grid></DataTemplate></GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasPosts, Mode=OneWay}">
                            <Grid><TextBlock x:Uid="AuthorDetail_PostsTab" Style="{StaticResource SubtitleTextBlockStyle}" /><HyperlinkButton HorizontalAlignment="Right" Tag="4" Click="OverviewSection_Click" Padding="0"><TextBlock x:Uid="AuthorDetail_ViewAll" /></HyperlinkButton></Grid>
                            <GridView Height="144" ItemsSource="{x:Bind ViewModel.PostPreviews}" IsItemClickEnabled="True" ItemClick="OverviewPost_ItemClick" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate><DataTemplate x:DataType="viewModels:PostImageGroupViewModel"><Grid Width="{x:Bind local:AuthorDetailPage.GetPreviewWidth(CoverAspectRatio, 132)}" Height="132" Margin="0,0,8,0"><Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image Stretch="Uniform" Source="{x:Bind local:AuthorDetailPage.CreatePostThumbnail(CoverImageUri), Mode=OneTime}" /></Border></Grid></DataTemplate></GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Scenes Tab -->
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8B9;" />
                        <TextBlock x:Uid="AuthorDetail_ScenesTab" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind local:AuthorDetailPage.FormatCount(ViewModel.SceneCount), Mode=OneWay}" />
                    </StackPanel>
                </PivotItem.Header>
                <GridView
                    x:Name="ScenesGrid"
                    AutomationProperties.AutomationId="AuthorScenesGrid"
                    Margin="0,8,0,0"
                    CanDragItems="True"
                    ContainerContentChanging="ScenesGrid_ContainerContentChanging"
                    DragItemsStarting="ScenesGrid_DragItemsStarting"
                    IsItemClickEnabled="True"
                    ItemClick="ScenesGrid_ItemClick"
                    ItemsSource="{x:Bind ViewModel.Scenes}"
                    SelectionMode="None">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection />
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:SceneCard">
                            <Grid
                                Margin="4"
                                Padding="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image
                                        x:Phase="1"
                                        Stretch="Uniform"
                                        Source="{x:Bind local:AuthorDetailPage.CreateThumbnail(ThumbnailUri), Mode=OneWay}" />
                                </Border>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="8,4"
                                    MaxLines="1"
                                    Text="{x:Bind FileName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind FileName}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>

            <!-- Characters Tab -->
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE77B;" />
                        <TextBlock x:Uid="AuthorDetail_CharactersTab" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind local:AuthorDetailPage.FormatCount(ViewModel.CharacterCount), Mode=OneWay}" />
                    </StackPanel>
                </PivotItem.Header>
                <GridView
                    x:Name="CharactersGrid"
                    AutomationProperties.AutomationId="AuthorCharactersGrid"
                    Margin="0,8,0,0"
                    CanDragItems="True"
                    ContainerContentChanging="CharactersGrid_ContainerContentChanging"
                    DragItemsStarting="CharactersGrid_DragItemsStarting"
                    IsItemClickEnabled="True"
                    ItemClick="CharactersGrid_ItemClick"
                    ItemsSource="{x:Bind ViewModel.Characters}"
                    SelectionMode="None">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection />
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:CharacterCard">
                            <Grid
                                Margin="4"
                                Padding="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image
                                        x:Phase="1"
                                        Stretch="Uniform"
                                        Source="{x:Bind local:AuthorDetailPage.CreateThumbnail(ThumbnailUri), Mode=OneWay}" />
                                </Border>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="8,4"
                                    MaxLines="1"
                                    Text="{x:Bind FileName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind FileName}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>

            <!-- Coordinates Tab -->
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE78A;" />
                        <TextBlock x:Uid="AuthorDetail_CoordinatesTab" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind local:AuthorDetailPage.FormatCount(ViewModel.CoordinateCount), Mode=OneWay}" />
                    </StackPanel>
                </PivotItem.Header>
                <GridView
                    x:Name="CoordinatesGrid"
                    AutomationProperties.AutomationId="AuthorCoordinatesGrid"
                    Margin="0,8,0,0"
                    CanDragItems="True"
                    ContainerContentChanging="CoordinatesGrid_ContainerContentChanging"
                    DragItemsStarting="CoordinatesGrid_DragItemsStarting"
                    IsItemClickEnabled="True"
                    ItemClick="CoordinatesGrid_ItemClick"
                    ItemsSource="{x:Bind ViewModel.Coordinates}"
                    SelectionMode="None">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection />
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:CoordinateCard">
                            <Grid
                                Margin="4"
                                Padding="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image
                                        x:Phase="1"
                                        Stretch="Uniform"
                                        Source="{x:Bind local:AuthorDetailPage.CreateThumbnail(ThumbnailUri), Mode=OneWay}" />
                                </Border>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="8,4"
                                    MaxLines="1"
                                    Text="{x:Bind FileName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind FileName}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>

            <!-- Posts Tab (added dynamically for providers with artwork scanning) -->
            <PivotItem
                x:Name="PostsPivotItem"
                x:Load="{x:Bind ViewModel.CanLoadPosts, Mode=OneWay}">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8F1;" />
                        <TextBlock x:Uid="AuthorDetail_PostsTab" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind local:AuthorDetailPage.FormatCount(ViewModel.PostCount), Mode=OneWay}" />
                    </StackPanel>
                </PivotItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Margin="0,8,0,4"
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasUnassignedImages, Mode=OneWay}">
                        <TextBlock
                            x:Uid="AuthorDetail_UnassignedFiles"
                            VerticalAlignment="Center" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.UnassignedImageCount, Mode=OneWay}" />
                        <Button
                            x:Uid="AuthorDetail_AssignUnclassified"
                            Click="AssignUnclassified_Click" />
                    </StackPanel>
                    <ProgressRing
                        Grid.RowSpan="2"
                        IsActive="{x:Bind ViewModel.IsLoadingPosts, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoadingPosts, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <GridView
                        Grid.Row="1"
                        x:Name="PostsGrid"
                        AutomationProperties.AutomationId="AuthorPostsGrid"
                        Margin="0,8,0,0"
                        IsItemClickEnabled="True"
                        ItemClick="PostsGrid_ItemClick"
                        ItemsSource="{x:Bind ViewModel.PostGroups}"
                        SelectionMode="None">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection />
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="220" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:PostImageGroupViewModel">
                                <Grid Padding="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Image Stretch="UniformToFill" Source="{x:Bind local:AuthorDetailPage.CreatePostThumbnail(CoverImageUri), Mode=OneTime}" />
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="6,3" CornerRadius="{StaticResource ControlCornerRadius}" Background="#AA000000" Visibility="{x:Bind HasAdditionalImages, Mode=OneTime}">
                                        <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE722;" FontSize="12" Foreground="White" /><TextBlock Text="{x:Bind AdditionalImageCountText, Mode=OneTime}" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                                    </Border>
                                    <TextBlock Grid.Row="1" Margin="8,6" Text="{x:Bind Post.DisplayTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>

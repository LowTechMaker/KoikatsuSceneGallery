<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.TagCloudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="BackButton"
                    x:Uid="TagCloud_Back"
                    AutomationProperties.AutomationId="TagCloudBackButton"
                    Click="Back_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="Heading"
                    x:Uid="TagCloud_Title"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <SelectorBar
                x:Name="ProviderBar"
                AutomationProperties.AutomationId="TagCloudProviderBar"
                SelectionChanged="Provider_Changed" />
            <!--  Offered, not applied: re-placing the cloud under someone who is
                  reading it moves every word they were looking at.  -->
            <InfoBar
                x:Name="CloudStaleBar"
                x:Uid="TagCloud_Stale"
                AutomationProperties.AutomationId="TagCloudStaleBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Uid="TagCloud_StaleRefresh" Click="StaleRefresh_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!--  The cloud. Not virtualized, hence the per-platform tag cap.  -->
        <Grid x:Name="CloudHost" Grid.Row="1" SizeChanged="Cloud_SizeChanged">
            <!--  A Canvas, not a wrapping panel: the cloud's shape comes from
                  where each word is placed, and wrapping can only ever produce
                  full-width rows.  -->
            <Canvas x:Name="CloudPanel" />
        </Grid>

        <Grid
            x:Name="ResultsHost"
            Grid.Row="1"
            RowSpacing="12"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  What the platform's own encyclopedia says about this tag.
                  Collapsed whenever the platform has no dictionary plugin, or
                  has one but nothing written about this particular tag.  -->
            <Border
                x:Name="ArticleCard"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="ArticleSummary"
                        MaxLines="4"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                <!--  The innermost parent is offered as a link because that
                      is what an alias entry points at, and pixiv gives no other
                      handle on a redirect.  -->
                <StackPanel
                    x:Name="ArticleParentRow"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="ArticleParents"
                        VerticalAlignment="Center"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <HyperlinkButton
                        x:Name="ArticleParentLink"
                        AutomationProperties.AutomationId="TagArticleParentLink"
                        Padding="4,0" />
                </StackPanel>
                <HyperlinkButton
                    x:Name="ArticleLink"
                    x:Uid="TagCloud_ArticleLink"
                    AutomationProperties.AutomationId="TagArticleLink"
                    HorizontalAlignment="Left"
                    Padding="4,0" />
                </StackPanel>
            </Border>

            <ContentControl
                x:Name="ResultsContent"
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </Grid>

        <StackPanel
            x:Name="BusyPanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <ProgressRing x:Name="BusyRing" IsActive="False" />
            <TextBlock x:Uid="TagCloud_Loading" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            x:Name="EmptyPanel"
            Grid.Row="1"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock
                x:Name="EmptyTitle"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="EmptyDescription"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>

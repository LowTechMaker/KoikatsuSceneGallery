<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.CharacterDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KoikatsuSceneGallery.Converters"
    xmlns:controls="using:KoikatsuSceneGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KoikatsuSceneGallery.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KoikatsuSceneGallery.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="PreviousCard_Invoked" />
        <KeyboardAccelerator Key="Right" Invoked="NextCard_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Uid="Detail_GoBack"
                Click="GoBack_Click"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <TextBlock
                Grid.Column="1"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Card.FileName, Mode=OneWay}" />

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="PrevButton"
                    x:Uid="Detail_PrevButton"
                    AutomationProperties.AutomationId="CharaDetailPrevButton"
                    Click="PrevButton_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Button>

                <Button
                    x:Name="RandomButton"
                    x:Uid="Detail_RandomButton"
                    AutomationProperties.AutomationId="CharaDetailRandomButton"
                    Click="RandomButton_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                </Button>

                <Button
                    x:Name="NextButton"
                    x:Uid="Detail_NextButton"
                    AutomationProperties.AutomationId="CharaDetailNextButton"
                    Click="NextButton_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Enabled">
                <Image
                    x:Name="PreviewImage"
                    AutomationProperties.AutomationId="CharaDetailPreviewImage"
                    CanDrag="True"
                    DragStarting="PreviewImage_DragStarting"
                    Stretch="Uniform" />
            </ScrollViewer>

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    Padding="16"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Spacing="16">

                <TextBlock
                    x:Uid="Detail_CharaInfo"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <ProgressRing
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Left"
                    IsActive="True"
                    Visibility="{x:Bind ViewModel.IsParsing, Mode=OneWay}" />

                <StackPanel
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.MetadataLoaded, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="Detail_CharaName"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.FullName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="Detail_CharaSex"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SexDisplay, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="Detail_CharaGame"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.GameDisplay, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="Detail_CharaMadevil"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.MadevilDisplay, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <!--  Version History (visible only when multiple versions exist)  -->
                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasMultipleVersions, Mode=OneWay}">
                    <TextBlock
                        x:Uid="Detail_VersionHistory"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}">
                        <Run Text="{x:Bind ViewModel.VersionIndex, Mode=OneWay}" /><Run Text=" / " /><Run Text="{x:Bind ViewModel.TotalVersions, Mode=OneWay}" />
                    </TextBlock>
                    <ListView
                        MaxHeight="400"
                        IsItemClickEnabled="True"
                        ItemClick="VersionItem_Click"
                        ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.Card, Mode=OneWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CharacterCard">
                                <Grid Padding="4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                x:Uid="Detail_RevealVersion"
                                                Click="RevealVersion_Click"
                                                Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xED43;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                x:Uid="Detail_DeleteVersion"
                                                Click="DeleteVersion_Click"
                                                Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Border
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Image Stretch="Uniform">
                                            <Image.Source>
                                                <BitmapImage
                                                    DecodePixelWidth="60"
                                                    UriSource="{x:Bind ThumbnailUri, Mode=OneWay}" />
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind VersionLabelText, Mode=OneWay}"
                                            Visibility="{x:Bind HasVersionLabel, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind VersionNote, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasVersionNote, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind local:CharacterDetailPage.FormatTimestamp((models:CharacterCard))}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Resolution}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FileSize, Converter={StaticResource FileSizeConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!--  Annotation for the card on screen. Deliberately not tied to
                      HasMultipleVersions: the first card of a character has to be
                      markable too, or a what-if version could never be created.  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="Detail_VersionAnnotation"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        x:Name="VersionKindBox"
                        AutomationProperties.AutomationId="CharaDetailVersionKindBox"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="VersionKind_SelectionChanged">
                        <ComboBoxItem x:Uid="Detail_VersionKind_Current" />
                        <ComboBoxItem x:Uid="Detail_VersionKind_Alternate" />
                    </ComboBox>
                    <!--  Independent of the kind above: a what-if version can be
                          replaced by a newer what-if, which one three-way choice
                          could not express.  -->
                    <CheckBox
                        x:Name="VersionSupersededBox"
                        x:Uid="Detail_VersionSuperseded"
                        AutomationProperties.AutomationId="CharaDetailVersionSupersededBox"
                        Checked="VersionSuperseded_Changed"
                        Unchecked="VersionSuperseded_Changed" />
                    <TextBox
                        x:Name="VersionNoteBox"
                        x:Uid="Detail_VersionNote"
                        AutomationProperties.AutomationId="CharaDetailVersionNoteBox"
                        KeyDown="VersionNote_KeyDown"
                        LostFocus="VersionNote_LostFocus" />
                    <Button
                        x:Uid="Detail_AssignGroup"
                        AutomationProperties.AutomationId="CharaDetailAssignGroupButton"
                        Click="AssignGroup_Click"
                        HorizontalAlignment="Stretch" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.GroupOverrideText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasGroupOverride, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    x:Uid="Detail_FileInfo"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Detail_FileName"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Card.FileName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Detail_FilePath"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Card.FilePath, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Detail_FileSize"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Card.FileSize, Converter={StaticResource FileSizeConverter}, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Detail_Resolution"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Card.Resolution, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Detail_DateModified"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Card.DateModified, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.HasPixivArtworkId, Mode=OneWay}">
                    <TextBlock
                        x:Uid="Detail_PixivArtworkId"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <HyperlinkButton
                        Padding="0"
                        Click="PixivButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE774;" />
                            <TextBlock Text="{x:Bind ViewModel.PixivArtworkId, Mode=OneWay}" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <StackPanel
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.HasBepisDbUrl, Mode=OneWay}">
                    <TextBlock
                        x:Uid="Detail_BepisDbId"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <HyperlinkButton
                        Padding="0"
                        Click="BepisDbButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE774;" />
                            <TextBlock Text="{x:Bind ViewModel.BepisDbId, Mode=OneWay}" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
                <controls:MetadataPanel FilePath="{x:Bind ViewModel.Card.FilePath, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:KoikatsuSceneGallery.Converters"
    xmlns:controls="using:KoikatsuSceneGallery.Controls"
    xmlns:pages="using:KoikatsuSceneGallery.Pages"
    xmlns:vm="using:KoikatsuSceneGallery.ViewModels"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Loaded="ImportPage_Loaded"
    Unloaded="ImportPage_Unloaded"
    GotFocus="ImportPage_GotFocus"
    SizeChanged="ImportPage_SizeChanged">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:PhaseToCancelButtonVisibilityConverter x:Key="PhaseToCancelButtonVisibilityConverter" />
        <DataTemplate x:Key="AuthorPickerItemTemplate" x:DataType="vm:SelectableAuthor">
            <Grid Padding="4,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="14" Glyph="&#xE77B;" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind Id}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Rows of the review list. One template per row kind; see ImportReviewTemplateSelector. -->
        <DataTemplate x:Key="ReviewSectionTemplate" x:DataType="vm:ImportReviewRow">
            <Grid Padding="4,18,8,6" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Padding="6" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                        Tag="{x:Bind}" Click="ReviewCollapse_Click"
                        x:Uid="Import_ToggleSection" AutomationProperties.HelpText="{x:Bind Title, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="12" />
                </Button>
                <CheckBox Grid.Column="1" IsThreeState="True" MinWidth="0" Padding="0" VerticalAlignment="Center"
                          IsChecked="{x:Bind SelectionState, Mode=OneWay}"
                          IsEnabled="{x:Bind HasSelectableItems, Mode=OneWay}"
                          Tag="{x:Bind}" Click="ReviewHeaderBox_Click"
                          AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" />
                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReviewGroupTemplate" x:DataType="vm:ImportReviewRow">
            <Grid Padding="40,8,8,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsThreeState="True" MinWidth="0" Padding="0" VerticalAlignment="Center"
                          IsChecked="{x:Bind SelectionState, Mode=OneWay}"
                          IsEnabled="{x:Bind HasSelectableItems, Mode=OneWay}"
                          Tag="{x:Bind}" Click="ReviewHeaderBox_Click"
                          AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" />
                <FontIcon Grid.Column="1" Glyph="&#xE8B7;" FontSize="13" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Title, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.HeadingLevel="Level3"
                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReviewCardTemplate" x:DataType="vm:ImportItemReviewState">
            <Grid Padding="40,6,4,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="Import_RemoveItemMenu" Tag="{x:Bind}" Click="RemoveReviewItem_Click" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                          VerticalAlignment="Center" MinWidth="0" Padding="0"
                          AutomationProperties.Name="{x:Bind Item.FileName}" />
                <Border Grid.Column="1" Width="64" Height="48" CornerRadius="4"
                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                    <Image Stretch="Uniform">
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="128" UriSource="{x:Bind Item.ThumbnailUri, Mode=OneWay}" />
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Item.FileName}" FontWeight="SemiBold" ToolTipService.ToolTip="{x:Bind Item.SourceFilePath}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                Background="{x:Bind pages:ImportPage.ToneBackground(Tone), Mode=OneWay}">
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12"
                                       Foreground="{x:Bind pages:ImportPage.ToneForeground(Tone), Mode=OneWay}" />
                        </Border>
                        <TextBlock Text="{x:Bind MetaText, Mode=OneWay}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind NoteText, Mode=OneWay}" Visibility="{x:Bind HasNote, Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind NoteText, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" MaxLines="1"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <controls:RatingBadge Grid.Column="3" VerticalAlignment="Center"
                                      Text="{x:Bind Item.RatingText, Mode=OneWay}" />
                <Button Grid.Column="4" x:Uid="Import_RemoveItem" VerticalAlignment="Center"
                        Padding="8" Background="Transparent" BorderThickness="0"
                        Tag="{x:Bind}" Click="RemoveReviewItem_Click"
                        AutomationProperties.Name="{x:Bind Item.FileName}">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReviewListTemplate" x:DataType="vm:ImportReviewRow">
            <ContentControl Content="{x:Bind Item, Mode=OneWay}"
                            HorizontalContentAlignment="Stretch" IsTabStop="False"
                            ContentTemplate="{StaticResource ReviewCardTemplate}" />
        </DataTemplate>

        <DataTemplate x:Key="ReviewModCardTemplate" x:DataType="vm:ModReviewItem">
            <Grid Padding="40,6,4,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="48" CornerRadius="4"
                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE7B8;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind SourcePath}">
                        <Run Text="{x:Bind Title}" FontWeight="SemiBold" />
                        <Run Text="  " /><Run Text="{x:Bind VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind IsChecking, Mode=OneWay}"
                                      Visibility="{x:Bind IsChecking, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" MaxLines="1"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind StatusDetail, Mode=OneWay}" TextWrapping="Wrap" MaxLines="3"
                               ToolTipService.ToolTip="{x:Bind StatusDetail, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <CheckBox Grid.Column="2" x:Uid="Import_Mods_InstallBox" VerticalAlignment="Center"
                          IsChecked="{x:Bind Install, Mode=TwoWay}" IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                          AutomationProperties.HelpText="{x:Bind Title}" />
                <Button Grid.Column="3" x:Uid="Import_RemoveItem" VerticalAlignment="Center"
                        Padding="8" Background="Transparent" BorderThickness="0"
                        Tag="{x:Bind}" Click="RemoveMod_Click"
                        AutomationProperties.Name="{x:Bind Title}">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReviewModTemplate" x:DataType="vm:ImportReviewRow">
            <ContentControl Content="{x:Bind Mod, Mode=OneWay}"
                            HorizontalContentAlignment="Stretch" IsTabStop="False"
                            ContentTemplate="{StaticResource ReviewModCardTemplate}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ContentControl x:Name="ImportWorkspace"
                    IsEnabled="{x:Bind ViewModel.IsReviewWorkspaceEnabled, Mode=OneWay}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, one-line summary, options. -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Uid="Import_Title" Style="{StaticResource PageTitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ReviewSummaryText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- Add, review, import: filled in code-behind from the page's state. -->
                <Border x:Name="StepsHost" Margin="0,6,0,0" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="ImportSteps" />
            </StackPanel>
            <!-- Out of the options flyout: it decides whether recognised cards wait for
                 review or go straight in, which is worth seeing before dropping files. -->
            <StackPanel x:Uid="Import_AutoImportHost" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock x:Uid="Import_AutoImportShort" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Uid="Import_AutoImportToggle" MinWidth="0" OnContent="" OffContent=""
                              AutomationProperties.AutomationId="ImportAutoImportIdentifiedToggle"
                              IsOn="{x:Bind Settings.AutoImportIdentifiedPosts, Mode=TwoWay}" />
            </StackPanel>
            <Button Grid.Column="2" VerticalAlignment="Center" AutomationProperties.AutomationId="ImportOptionsButton"
                    x:Uid="Import_OptionsButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                    <TextBlock x:Uid="Import_OptionsLabel" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="300" Spacing="12">
                            <TextBlock x:Uid="Import_OptionsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button AutomationProperties.AutomationId="ImportRefreshLibraryIndexButton"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.RefreshLibraryIndexCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    <TextBlock x:Uid="Import_RefreshLibraryIndex" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CookieSetupButton" AutomationProperties.AutomationId="ImportCookieSetupButton"
                                    HorizontalAlignment="Stretch" Click="CookieSetup_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8C7;" />
                                    <TextBlock x:Uid="Import_CookieSetup" />
                                </StackPanel>
                            </Button>
                            <NumberBox x:Uid="Import_SubfolderThreshold" Minimum="-1" Maximum="99"
                                       SmallChange="1" SpinButtonPlacementMode="Compact"
                                       IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                       Value="{x:Bind ViewModel.ArtworkSubfolderThreshold, Mode=TwoWay}" />
                            <controls:WrapPanel x:Uid="Import_RatingSummary" Spacing="12"
                                                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                                <TextBlock x:Uid="Import_RatingSummaryLabel" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:RatingBadge Text="G" />
                                    <TextBlock Text="{x:Bind ViewModel.AllAgesCount, Mode=OneWay}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:RatingBadge Text="R-18" />
                                    <TextBlock Text="{x:Bind ViewModel.R18Count, Mode=OneWay}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:RatingBadge Text="R-18G" />
                                    <TextBlock Text="{x:Bind ViewModel.R18GCount, Mode=OneWay}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </StackPanel>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Messages: a rollback error, the rejected-files warning and the last result
             share one bar, most urgent first; closing it brings up the next. -->
        <InfoBar x:Name="ImportMessageBar" Grid.Row="1" IsClosable="True"
                 AutomationProperties.AutomationId="ImportMessageBar"
                 CloseButtonClick="ImportMessageBar_CloseButtonClick">
            <TextBlock x:Name="ImportMessageMore" Margin="0,0,0,12" Visibility="Collapsed"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </InfoBar>

        <Border x:Name="DropZone" Grid.Row="2" CornerRadius="16" Margin="0,0,0,16"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <Grid>
                <controls:ImportDropZoneContent PickFilesRequested="PickFiles_Click"
                                                Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                            Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}">
                    <ProgressRing Width="56" Height="56" IsActive="True" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.AnalysisStatusText, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The list: one card, sections inside it. -->
        <Border Grid.Row="2" Padding="12,10,8,8" CornerRadius="12"
                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="10" Padding="8,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectAllBox" IsThreeState="True" MinWidth="0" VerticalAlignment="Center"
                              x:Uid="Import_SelectAll"
                              IsChecked="{x:Bind ViewModel.IsAllReviewSelected, Mode=OneWay}"
                              Click="SelectAllBox_Click" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ReviewSelectionText, Mode=OneWay}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.AnalysisLoadingVisibility, Mode=OneWay}">
                        <ProgressRing Width="16" Height="16" IsActive="True" />
                        <TextBlock Text="{x:Bind ViewModel.AnalysisStatusText, Mode=OneWay}" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="3" x:Uid="Import_RatingFilter" MinWidth="120"
                              SelectedIndex="{x:Bind ViewModel.ReviewFilterIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="Import_AllRatings" />
                        <ComboBoxItem Content="G" /><ComboBoxItem Content="R-18" /><ComboBoxItem Content="R-18G" />
                    </ComboBox>
                </Grid>

                <ListView x:Name="ReviewListHost" Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.ReviewRows}"
                          x:Uid="Import_Mixed_Workspace"
                          SelectionMode="None" IsItemClickEnabled="False"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="IsTabStop" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplateSelector>
                        <controls:ImportReviewTemplateSelector SectionTemplate="{StaticResource ReviewSectionTemplate}"
                            GroupTemplate="{StaticResource ReviewGroupTemplate}" ListTemplate="{StaticResource ReviewListTemplate}"
                            ModTemplate="{StaticResource ReviewModTemplate}" />
                    </ListView.ItemTemplateSelector>
                </ListView>
            </Grid>
        </Border>

        <!-- Shares the workspace cell, so it can never spill past that card's bounds.
             Staying in the page's visual tree also keeps the page-level Drop handler
             covering it, which a Popup or Flyout would not. -->
        <Grid x:Name="AddFilesOverlay" Grid.Row="2"
              Visibility="Collapsed" Background="Transparent"
              AutomationProperties.AutomationId="ImportAddFilesOverlay"
              SizeChanged="AddFilesOverlay_SizeChanged"
              Tapped="AddFilesOverlay_Tapped">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="AddFilesOverlayEscape_Invoked" />
            </Grid.KeyboardAccelerators>
            <!-- Left margin is set in code-behind so the card sits directly above
                 the button that opened it; bottom margin is the gap to that button. -->
            <Border x:Name="AddFilesOverlayCard" x:Uid="Import_AddFilesOverlayCard"
                    MaxWidth="560" MaxHeight="320" Margin="0,0,0,8" Padding="24"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    IsTabStop="True" UseSystemFocusVisuals="False"
                    CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    SizeChanged="AddFilesOverlayCard_SizeChanged"
                    Tapped="AddFilesOverlayCard_Tapped">
                <controls:ImportDropZoneContent x:Name="AddFilesOverlayContent"
                                                UseBoxArtwork="True"
                                                PickFilesRequested="PickFiles_Click" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="8" Padding="0,0,0,16" Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
            <!-- Appears with a selection: everything that can be done to the selected cards, in one row. -->
            <Border x:Name="SelectionBar" Padding="12,8" CornerRadius="10"
                    Visibility="{x:Bind ViewModel.ReviewSelectionEditorVisibility, Mode=OneWay}"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="{x:Bind ViewModel.SelectedReviewCountText, Mode=OneWay}" />
                        <TextBox x:Name="ReviewArtworkInput" Grid.Column="1" x:Uid="Import_LookupInput"
                                 Text="{x:Bind ViewModel.ReviewArtworkId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="ReviewArtworkInput_KeyDown" />
                        <ComboBox Grid.Column="2" x:Uid="Import_LookupProvider" MinWidth="110"
                                  ItemsSource="{x:Bind ViewModel.ReviewArtworkProviderIds}"
                                  SelectedItem="{x:Bind ViewModel.ReviewArtworkProviderId, Mode=TwoWay}" />
                        <Button Grid.Column="3" x:Uid="Import_LookupFetch" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.FetchReviewArtworkCommand}" />
                    </Grid>
                    <!-- A command bar rather than a row of buttons: it keeps one line and folds
                         what does not fit into "More" when the window is narrow. -->
                    <CommandBar x:Name="SelectionCommands" HorizontalAlignment="Left" Background="Transparent"
                                DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto"
                                AutomationProperties.AutomationId="ImportSelectionCommands">
                        <AppBarButton x:Name="ReviewEditButton" x:Uid="Import_SelAuthor">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE77B;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <Flyout x:Name="ReviewEditFlyout" Placement="TopEdgeAlignedLeft">
                                    <StackPanel Width="300" Spacing="10">
                                        <TextBlock x:Uid="Import_SelectionAuthorTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Button x:Uid="Import_SelectAuthor" Click="PickReviewAuthor_Click" HorizontalAlignment="Stretch">
                                            <TextBlock x:Uid="Import_PickKnownAuthor" />
                                        </Button>
                                        <ComboBox x:Uid="Import_Review_AuthorProvider" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.ReviewAuthorProviderIds}"
                                                  SelectedItem="{x:Bind ViewModel.ReviewAuthorProviderId, Mode=TwoWay}" />
                                        <TextBox x:Uid="Import_Review_AuthorId"
                                                 Text="{x:Bind ViewModel.ReviewAuthorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button x:Uid="Import_AssignAuthor" HorizontalAlignment="Stretch"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Command="{x:Bind ViewModel.ApplyReviewAuthorCommand}" />
                                    </StackPanel>
                                </Flyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton x:Uid="Import_SelRating">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE7BA;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedLeft">
                                    <MenuFlyoutItem Text="G" Tag="1" Click="ApplySelectionRating_Click" />
                                    <MenuFlyoutItem Text="R-18" Tag="2" Click="ApplySelectionRating_Click" />
                                    <MenuFlyoutItem Text="R-18G" Tag="3" Click="ApplySelectionRating_Click" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton x:Uid="Import_SelSearch" Click="SearchSelected_Click">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Uid="Import_SelAuthorCheck" Click="OpenAuthorCheck_Click"
                                      Visibility="{x:Bind ViewModel.AuthorCheckVisibility}">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8FD;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton x:Uid="Import_SelRemove" Command="{x:Bind ViewModel.RemoveReviewSelectionCommand}">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Uid="Import_SelClear" Click="ClearSelection_Click">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE894;" /></AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                    <TextBlock Text="{x:Bind ViewModel.ReviewBatchStatusText, Mode=OneWay}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.ReviewBatchStatusText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ReviewBatchStatusVisibility, Mode=OneWay}"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.LinkMatchText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.LinkMatchVisibility, Mode=OneWay}"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LinkMissingBlock"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.LinkMissingVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <!-- Episodes of the share nothing was taken from: not missing, just not started. -->
                    <TextBlock x:Name="LinkUnstartedBlock" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.LinkUnstartedVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!-- Orange rather than the caution yellow: not lost, the library has it. -->
                    <TextBlock x:Name="LinkInLibraryBlock"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.LinkInLibraryVisibility, Mode=OneWay}">
                        <TextBlock.Foreground><SolidColorBrush Color="#E8892B" /></TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Footer: add more, what Import will do, and Import. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="AddFilesButton" Click="ShowAddFilesOverlay_Click" x:Uid="Import_AddFilesButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="Import_AddFilesLabel" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" x:Uid="Import_MoreButton" Padding="10,5">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem x:Uid="Import_More_Undo"
                                            Command="{x:Bind ViewModel.UndoManualAssignmentCommand}"
                                            Visibility="{x:Bind ViewModel.CanUndoManualAssignment, Mode=OneWay}" />
                            <MenuFlyoutItem x:Uid="Import_More_Clear"
                                            Command="{x:Bind ViewModel.ClearCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <TextBlock x:Name="ImportPlanBlock" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" Margin="8,0"
                           Text="{x:Bind ViewModel.ImportPlanText, Mode=OneWay}"
                           ToolTipService.ToolTip="{x:Bind ViewModel.ImportPlanText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <CheckBox Grid.Column="3" VerticalAlignment="Center" MinWidth="0"
                          Content="{x:Bind ViewModel.IncludeUnidentifiedText, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.IncludeUnidentified, Mode=TwoWay}"
                          Visibility="{x:Bind ViewModel.IncludeUnidentifiedVisibility, Mode=OneWay}"
                          x:Uid="Import_IncludeUnidentifiedBox" />
                <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}" MinWidth="120"
                        AutomationProperties.AutomationId="ImportConfirmButton"
                        Click="ConfirmImport_Click"
                        IsEnabled="{x:Bind ViewModel.CanConfirmImport, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.ImportPlanText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE896;" />
                        <TextBlock x:Uid="Import_ConfirmButtonText" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
    </ContentControl>
    <Grid x:Name="TransactionProgressOverlay" Grid.Row="1" Padding="24,16"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}">
        <StackPanel MaxWidth="720" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="{x:Bind ViewModel.TransactionStatusText, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <ProgressBar Minimum="0"
                         Maximum="{x:Bind ViewModel.ExecutionProgress.TotalCount, Mode=OneWay}"
                         Value="{x:Bind ViewModel.ExecutionProgress.CompletedCount, Mode=OneWay}"
                         Height="4" HorizontalAlignment="Stretch" />
            <TextBlock Text="{x:Bind ViewModel.TransactionProgressCountsText, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Uid="Import_CancelButton"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.CancelImportCommand}"
                    Visibility="{x:Bind ViewModel.ExecutionProgress.Phase, Mode=OneWay, Converter={StaticResource PhaseToCancelButtonVisibilityConverter}}" />
        </StackPanel>
    </Grid>
    </Grid>
</Page>

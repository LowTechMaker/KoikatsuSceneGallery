<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:KoikatsuSceneGallery.Converters"
    xmlns:controls="using:KoikatsuSceneGallery.Controls"
    xmlns:models="using:KoikatsuSceneGallery.Models"
    xmlns:vm="using:KoikatsuSceneGallery.ViewModels"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Loaded="ImportPage_Loaded"
    SizeChanged="ImportPage_SizeChanged">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:PhaseToCancelButtonVisibilityConverter x:Key="PhaseToCancelButtonVisibilityConverter" />
        <DataTemplate x:Key="AuthorPickerItemTemplate" x:DataType="vm:SelectableAuthor">
            <Grid Padding="4,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="14" Glyph="&#xE77B;" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind Id}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReviewFileTemplate" x:DataType="models:ImportItem">
            <Grid Padding="8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="92" Height="69" CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <Image Stretch="UniformToFill">
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="160" UriSource="{x:Bind ThumbnailUri, Mode=OneWay}" />
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind FileName}" Style="{StaticResource BodyTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border CornerRadius="{StaticResource ControlCornerRadius}" Padding="5,1"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <TextBlock FontSize="11" Text="{x:Bind CardTypeText, Mode=OneWay}" />
                        </Border>
                        <controls:RatingBadge Text="{x:Bind RatingText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel x:Uid="Import_RatingTooltip" Orientation="Horizontal" Spacing="4">
                        <ToggleButton Content="G" MinWidth="38" IsChecked="{x:Bind IsAllAgesRating, Mode=TwoWay}" />
                        <ToggleButton Content="R-18" MinWidth="52" IsChecked="{x:Bind IsR18Rating, Mode=TwoWay}" />
                        <ToggleButton Content="R-18G" MinWidth="60" IsChecked="{x:Bind IsR18GRating, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <ProgressRing Width="14" Height="14" IsActive="True"
                                  Visibility="{x:Bind ShowStatusRing, Mode=OneWay}" />
                    <FontIcon FontSize="14" Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                              Visibility="{x:Bind ShowStatusGlyph, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResolvedFileTemplate" x:DataType="models:ImportItem">
            <Grid Padding="8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="76" Height="57" CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                    <Image Stretch="UniformToFill">
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="128" UriSource="{x:Bind ThumbnailUri, Mode=OneWay}" />
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind FileName}" Style="{StaticResource BodyTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <controls:RatingBadge Text="{x:Bind RatingText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind DestinationPath, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" MaxLines="1"
                               Visibility="{x:Bind HasDestination, Mode=OneWay}" />
                </StackPanel>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <ProgressRing Width="14" Height="14" IsActive="True"
                                  Visibility="{x:Bind ShowStatusRing, Mode=OneWay}" />
                    <FontIcon FontSize="14" Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                              Visibility="{x:Bind ShowStatusGlyph, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ContentControl x:Name="ImportWorkspace"
                    IsEnabled="{x:Bind ViewModel.IsReviewWorkspaceEnabled, Mode=OneWay}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Uid="Import_Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ReviewSummaryText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Uid="Import_Options" VerticalAlignment="Center">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="280" Spacing="12">
                            <TextBlock x:Uid="Import_OptionsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button AutomationProperties.AutomationId="ImportRefreshLibraryIndexButton"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.RefreshLibraryIndexCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    <TextBlock x:Uid="Import_RefreshLibraryIndex" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CookieSetupButton" AutomationProperties.AutomationId="ImportCookieSetupButton"
                                    HorizontalAlignment="Stretch" Click="CookieSetup_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8C7;" />
                                    <TextBlock x:Uid="Import_CookieSetup" />
                                </StackPanel>
                            </Button>
                            <NumberBox x:Uid="Import_SubfolderThreshold" Minimum="-1" Maximum="99"
                                       SmallChange="1" SpinButtonPlacementMode="Compact"
                                       IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                       Value="{x:Bind ViewModel.ArtworkSubfolderThreshold, Mode=TwoWay}" />
                            <controls:WrapPanel x:Uid="Import_RatingSummary" Spacing="12"
                                                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                                <TextBlock x:Uid="Import_RatingSummaryLabel" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:RatingBadge Text="G" />
                                    <TextBlock Text="{x:Bind ViewModel.AllAgesCount, Mode=OneWay}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:RatingBadge Text="R-18" />
                                    <TextBlock Text="{x:Bind ViewModel.R18Count, Mode=OneWay}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:RatingBadge Text="R-18G" />
                                    <TextBlock Text="{x:Bind ViewModel.R18GCount, Mode=OneWay}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </StackPanel>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <InfoBar x:Name="RejectedWarningBar" Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.ShowRejectedWarning, Mode=TwoWay}"
                 Severity="Warning" IsClosable="True" />

        <Border x:Name="DropZone" Grid.Row="2" CornerRadius="16" Margin="0,0,0,16"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <Grid>
                <controls:ImportDropZoneContent PickFilesRequested="PickFiles_Click"
                                                Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                            Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}">
                    <ProgressRing Width="56" Height="56" IsActive="True" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.AnalysisStatusText, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                        <Border Padding="12" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8"
                                            Visibility="{x:Bind ViewModel.AnalysisLoadingVisibility, Mode=OneWay}">
                                    <ProgressRing Width="16" Height="16" IsActive="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Uid="Import_ReviewLoading" Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.AnalysisStatusText, Mode=OneWay}"
                                               HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="440"
                                            Visibility="{x:Bind ViewModel.EmptyReviewWorkspaceVisibility, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.ReviewEmptyTitle, Mode=OneWay}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               HorizontalAlignment="Center" TextAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.ReviewEmptyDescription, Mode=OneWay}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid x:Name="ReviewContentGrid" Grid.Row="1"
                                      Visibility="{x:Bind ViewModel.FlatReviewWorkspaceVisibility, Mode=OneWay}" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind ViewModel.ReviewSelectionText, Mode=OneWay}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ComboBox Grid.Column="1" x:Uid="Import_RatingFilter" MinWidth="120"
                                                      SelectedIndex="{x:Bind ViewModel.ReviewFilterIndex, Mode=TwoWay}">
                                                <ComboBoxItem x:Uid="Import_AllRatings" />
                                                <ComboBoxItem Content="G" /><ComboBoxItem Content="R-18" /><ComboBoxItem Content="R-18G" />
                                            </ComboBox>
                                            <Button x:Name="ReviewEditButton" Grid.Column="2" x:Uid="Import_EditSelected"
                                                    Visibility="{x:Bind ViewModel.ReviewSelectionEditorVisibility, Mode=OneWay}">
                                                <Button.Flyout>
                                                    <Flyout x:Name="ReviewEditFlyout" Placement="BottomEdgeAlignedRight">
                                                        <ScrollViewer x:Name="ReviewEditScrollViewer" MaxHeight="440" VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                                            <StackPanel x:Name="ReviewEditPanel" Width="320" Spacing="10">
                                                                <TextBlock x:Uid="Import_EditSelectedMetadata" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                                <TextBox x:Name="ReviewArtworkInput" x:Uid="Import_LookupInput"
                                                                         HorizontalAlignment="Stretch"
                                                                         Text="{x:Bind ViewModel.ReviewArtworkId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         KeyDown="ReviewArtworkInput_KeyDown" />
                                                                <ComboBox x:Uid="Import_LookupProvider" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Bind ViewModel.ReviewArtworkProviderIds}"
                                                                          SelectedItem="{x:Bind ViewModel.ReviewArtworkProviderId, Mode=TwoWay}" />
                                                                <StackPanel Spacing="8">
                                                                    <Button x:Uid="Import_LookupFetch" HorizontalAlignment="Stretch"
                                                                            Command="{x:Bind ViewModel.FetchReviewArtworkCommand}"
                                                                            IsEnabled="{x:Bind ViewModel.HasSelectedReviewItems, Mode=OneWay}" />
                                                                    <Button x:Uid="Import_SearchSelected" HorizontalAlignment="Stretch"
                                                                            Click="SearchSelected_Click"
                                                                            IsEnabled="{x:Bind ViewModel.HasSelectedReviewItems, Mode=OneWay}" />
                                                                </StackPanel>
                                                                <TextBlock x:Uid="Import_EditSelectedDetails" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                                                                <ComboBox x:Uid="Import_Review_Rating" HorizontalAlignment="Stretch"
                                                                          SelectedIndex="{x:Bind ViewModel.ReviewRatingOverrideIndex, Mode=TwoWay}">
                                                                    <ComboBoxItem x:Uid="Import_Review_KeepUnchanged" />
                                                                    <ComboBoxItem Content="G" /><ComboBoxItem Content="R-18" /><ComboBoxItem Content="R-18G" />
                                                                </ComboBox>
                                                                <Button x:Uid="Import_ApplyRating" HorizontalAlignment="Stretch"
                                                                        Command="{x:Bind ViewModel.ApplyReviewRatingCommand}"
                                                                        IsEnabled="{x:Bind ViewModel.HasSelectedReviewItems, Mode=OneWay}" />
                                                                <Button x:Uid="Import_SelectAuthor" Click="PickReviewAuthor_Click" HorizontalAlignment="Stretch">
                                                                    <TextBlock x:Uid="Import_PickKnownAuthor" />
                                                                </Button>
                                                                <ComboBox x:Uid="Import_Review_AuthorProvider" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Bind ViewModel.ReviewAuthorProviderIds}"
                                                                          SelectedItem="{x:Bind ViewModel.ReviewAuthorProviderId, Mode=TwoWay}" />
                                                                <TextBox x:Uid="Import_Review_AuthorId"
                                                                         Text="{x:Bind ViewModel.ReviewAuthorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <Button x:Uid="Import_AssignAuthor" HorizontalAlignment="Stretch"
                                                                        Command="{x:Bind ViewModel.ApplyReviewAuthorCommand}"
                                                                        IsEnabled="{x:Bind ViewModel.HasSelectedReviewItems, Mode=OneWay}">
                                                                </Button>
                                                                <Button x:Uid="Import_RemoveSelected" HorizontalAlignment="Stretch"
                                                                        Command="{x:Bind ViewModel.RemoveReviewSelectionCommand}"
                                                                        IsEnabled="{x:Bind ViewModel.HasSelectedReviewItems, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.ReviewBatchStatusText, Mode=OneWay}"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.ReviewBatchStatusText, Mode=OneWay}"
                                                   Visibility="{x:Bind ViewModel.ReviewBatchStatusVisibility, Mode=OneWay}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ListView x:Name="ReviewListHost"
                                              ItemsSource="{x:Bind ViewModel.ReviewRows}"
                                              SizeChanged="ReviewListHost_SizeChanged"
                                              x:Uid="Import_Mixed_Workspace"
                                              SelectionMode="None" IsItemClickEnabled="False"
                                              HorizontalContentAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollMode="Disabled"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="IsTabStop" Value="False" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.Resources>
                                            <DataTemplate x:Key="ReviewListItemTemplate" x:DataType="vm:ImportItemReviewState">
                                                <Grid Padding="8,10" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                                                              VerticalAlignment="Center" MinWidth="0" Padding="0"
                                                              AutomationProperties.Name="{x:Bind Item.FileName}" />
                                                    <Border Grid.Column="1" Width="72" Height="54" CornerRadius="4"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                        <Image Stretch="Uniform">
                                                            <Image.Source>
                                                                <BitmapImage DecodePixelWidth="144"
                                                                             UriSource="{x:Bind Item.ThumbnailUri, Mode=OneWay}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Item.FileName}" FontWeight="SemiBold" ToolTipService.ToolTip="{x:Bind Item.SourceFilePath}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        <TextBlock TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                            <Run Text="{x:Bind DisplayAuthorName, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{x:Bind DisplayArtworkKey, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{x:Bind Item.CardTypeText, Mode=OneWay}" />
                                                            <Run Text=" · " /><Run Text="{x:Bind StatusText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{x:Bind DestinationText, Mode=OneWay}"
                                                                   ToolTipService.ToolTip="{x:Bind Item.DestinationPath, Mode=OneWay}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <controls:RatingBadge Grid.Column="3" VerticalAlignment="Center"
                                                                          Text="{x:Bind Item.RatingText, Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="ReviewSectionTemplate" x:DataType="vm:ImportReviewRow">
                                                <Grid Padding="8,16,8,8" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                                                   AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" x:Uid="Import_SelectSection" VerticalAlignment="Top"
                                                            Tag="{x:Bind}" Click="SelectReviewSection_Click"
                                                            IsEnabled="{x:Bind HasSelectableItems, Mode=OneWay}"
                                                            AutomationProperties.HelpText="{x:Bind Title, Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="ReviewGroupTemplate" x:DataType="vm:ImportReviewRow">
                                                <Grid Padding="8,8,8,4" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                                               AutomationProperties.HeadingLevel="Level3" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                                                    <Button Grid.Column="1" x:Uid="Import_SelectGroup" Click="SelectMixedReviewGroup_Click" Tag="{x:Bind}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="ReviewAttentionTemplate" x:DataType="vm:ImportReviewRow">
                                                <ContentControl Content="{x:Bind Item, Mode=OneWay}"
                                                                HorizontalContentAlignment="Stretch" IsTabStop="False"
                                                                ContentTemplate="{StaticResource ReviewListItemTemplate}" />
                                            </DataTemplate>
                                            <DataTemplate x:Key="ReviewGridRowTemplate" x:DataType="vm:ImportReviewRow">
                                                <!-- Only this viewport row's bounded number of tiles is realized. -->
                                                <ItemsControl ItemsSource="{x:Bind Items, Mode=OneWay}" Padding="8,4,0,8" IsTabStop="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ImportItemReviewState">
                                                            <ToggleButton Width="{x:Bind TileWidth, Mode=OneWay}" Padding="8" Height="226"
                                                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                                                                          AutomationProperties.Name="{x:Bind Item.FileName}"
                                                                          AutomationProperties.HelpText="{x:Bind StatusText, Mode=OneWay}"
                                                                          ToolTipService.ToolTip="{x:Bind Item.SourceFilePath}">
                                                                <Grid RowSpacing="6">
                                                                    <Grid.RowDefinitions><RowDefinition Height="120" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4">
                                                                        <Image Stretch="Uniform">
                                                                            <Image.Source><BitmapImage DecodePixelWidth="400" UriSource="{x:Bind Item.ThumbnailUri, Mode=OneWay}" /></Image.Source>
                                                                        </Image>
                                                                    </Border>
                                                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}" IsHitTestVisible="False" IsTabStop="False"
                                                                              AutomationProperties.AccessibilityView="Raw" Margin="4" MinWidth="0" MinHeight="24"
                                                                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                                    <controls:RatingBadge Text="{x:Bind Item.RatingText, Mode=OneWay}" Margin="4"
                                                                                          HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Row="1" Text="{x:Bind Item.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Row="2" Text="{x:Bind DisplayAuthorName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                                                    <TextBlock Grid.Row="3" Text="{x:Bind StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                                               ToolTipService.ToolTip="{x:Bind DestinationText, Mode=OneWay}"
                                                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                                                </Grid>
                                                            </ToggleButton>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ListView.Resources>
                                        <ListView.ItemTemplateSelector>
                                            <controls:ImportReviewTemplateSelector SectionTemplate="{StaticResource ReviewSectionTemplate}"
                                                GroupTemplate="{StaticResource ReviewGroupTemplate}" ListTemplate="{StaticResource ReviewAttentionTemplate}"
                                                GridTemplate="{StaticResource ReviewGridRowTemplate}" />
                                        </ListView.ItemTemplateSelector>
                                    </ListView>
                                    <StackPanel x:Name="ReviewJumpPanel" Grid.Column="1" MinWidth="124" MaxWidth="180"
                                                Visibility="Collapsed" VerticalAlignment="Top" Spacing="8" Margin="0,16,0,0">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="36"
                                                Content="{x:Bind ViewModel.UnidentifiedNavigationText, Mode=OneWay}"
                                                Tag="Unidentified" Click="JumpToReviewSection_Click" />
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="36"
                                                Content="{x:Bind ViewModel.UnavailableNavigationText, Mode=OneWay}"
                                                Tag="Unavailable" Click="JumpToReviewSection_Click" />
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="36"
                                                Content="{x:Bind ViewModel.IdentifiedNavigationText, Mode=OneWay}"
                                                Tag="Identified" Click="JumpToReviewSection_Click" />
                                    </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

        </Grid>

        <!-- Shares the workspace cell, so it can never spill past that card's bounds.
             Staying in the page's visual tree also keeps the page-level Drop handler
             covering it, which a Popup or Flyout would not. -->
        <Grid x:Name="AddFilesOverlay" Grid.Row="2"
              Visibility="Collapsed" Background="Transparent"
              AutomationProperties.AutomationId="ImportAddFilesOverlay"
              SizeChanged="AddFilesOverlay_SizeChanged"
              Tapped="AddFilesOverlay_Tapped">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="AddFilesOverlayEscape_Invoked" />
            </Grid.KeyboardAccelerators>
            <!-- Left margin is set in code-behind so the card sits directly above
                 the button that opened it; bottom margin is the gap to that button. -->
            <Border x:Name="AddFilesOverlayCard" x:Uid="Import_AddFilesOverlayCard"
                    MaxWidth="560" MaxHeight="320" Margin="0,0,0,8" Padding="24"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    IsTabStop="True" UseSystemFocusVisuals="False"
                    CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    SizeChanged="AddFilesOverlayCard_SizeChanged"
                    Tapped="AddFilesOverlayCard_Tapped">
                <controls:ImportDropZoneContent x:Name="AddFilesOverlayContent"
                                                UseBoxArtwork="True"
                                                PickFilesRequested="PickFiles_Click" />
            </Border>
        </Grid>

        <Grid Grid.Row="3" Padding="0,8,0,16" ColumnSpacing="8"
              Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AddFilesButton" x:Uid="Import_AddFiles"
                    HorizontalAlignment="Left" Click="ShowAddFilesOverlay_Click" />
            <Button Grid.Column="1" x:Uid="Import_More">
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                        <MenuFlyoutItem x:Uid="Import_More_Undo"
                                        Command="{x:Bind ViewModel.UndoManualAssignmentCommand}"
                                        Visibility="{x:Bind ViewModel.CanUndoManualAssignment, Mode=OneWay}" />
                        <MenuFlyoutItem x:Uid="Import_More_Clear"
                                        Command="{x:Bind ViewModel.ClearCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ConfirmImportCommand}"
                    IsEnabled="{x:Bind ViewModel.CanConfirmImport, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ImportActionText, Mode=OneWay}"
                    AutomationProperties.HelpText="{x:Bind ViewModel.ImportActionText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                    <TextBlock x:Name="ImportFullActionText" Visibility="Collapsed"
                               Text="{x:Bind ViewModel.ImportActionText, Mode=OneWay}" />
                    <TextBlock x:Name="ImportCompactActionText"
                               Text="{x:Bind ViewModel.ImportCompactActionText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
    </ContentControl>
    <Grid x:Name="TransactionProgressOverlay" Grid.Row="1" Padding="24,16"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}">
        <StackPanel MaxWidth="720" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="{x:Bind ViewModel.TransactionStatusText, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <ProgressBar Minimum="0"
                         Maximum="{x:Bind ViewModel.ExecutionProgress.TotalCount, Mode=OneWay}"
                         Value="{x:Bind ViewModel.ExecutionProgress.CompletedCount, Mode=OneWay}"
                         Height="4" HorizontalAlignment="Stretch" />
            <TextBlock Text="{x:Bind ViewModel.TransactionProgressCountsText, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Uid="Import_CancelButton"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.CancelImportCommand}"
                    Visibility="{x:Bind ViewModel.ExecutionProgress.Phase, Mode=OneWay, Converter={StaticResource PhaseToCancelButtonVisibilityConverter}}" />
        </StackPanel>
    </Grid>
    </Grid>
</Page>

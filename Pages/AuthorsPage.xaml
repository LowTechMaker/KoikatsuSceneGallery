<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.AuthorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KoikatsuSceneGallery.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:KoikatsuSceneGallery.Controls"
    xmlns:converters="using:KoikatsuSceneGallery.Converters"
    xmlns:services="using:KoikatsuSceneGallery.Services"
    xmlns:viewModels="using:KoikatsuSceneGallery.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--  One platform's authors. This was a Pivot.ItemTemplate: with a
              platform named in the title bar the pivot had exactly one tab, and
              a tab strip of one announces a choice that does not exist. The
              pivot is gone; the template is hosted directly and the platform
              picker below appears only when there is something to pick.  -->
        <DataTemplate x:Key="AuthorTabTemplate" x:DataType="viewModels:AuthorProviderTabViewModel">
            <Grid>
                <!--  Wave 17: a click selects (the details pane beside the grid says
                      who it is); a double click or Enter opens the author's page.  -->
                <GridView x:Name="AuthorsGrid" ItemsSource="{x:Bind GroupedAuthors.View}"
                          IsItemClickEnabled="False" SelectionMode="Single"
                          SelectionChanged="AuthorsGrid_SelectionChanged" DoubleTapped="AuthorsGrid_DoubleTapped"
                          PreviewKeyDown="AuthorsGrid_PreviewKeyDown"
                          Loaded="AuthorsGrid_Loaded" SizeChanged="AuthorsGrid_SizeChanged">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" GroupHeaderPlacement="Top" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style></GridView.ItemContainerStyle>
                    <GridView.GroupStyle><GroupStyle HidesIfEmpty="True">
                        <!--  The stock header container draws a divider under
                              its content and keeps its padding and min height
                              even when the header inside is collapsed — so the
                              ungrouped sorts showed a stray rule, and a band of
                              empty space, between the platform bar and the
                              first row. Bare presenter: the header template
                              brings its own spacing when it has something to
                              say.  -->
                        <GroupStyle.HeaderContainerStyle><Style TargetType="GridViewHeaderItem">
                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="GridViewHeaderItem">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </ControlTemplate>
                            </Setter.Value></Setter>
                        </Style></GroupStyle.HeaderContainerStyle>
                        <GroupStyle.HeaderTemplate><DataTemplate x:DataType="viewModels:AuthorGroupViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" Margin="4,12,0,8" Visibility="{x:Bind ShowHeader}">
                                <TextBlock Text="{x:Bind Header}" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind CountText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate></GroupStyle.HeaderTemplate>
                    </GroupStyle></GridView.GroupStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="services:AuthorSummary">
                            <Grid Margin="4"
                                  ToolTipService.ToolTip="{x:Bind Display.ProfileUrl}">
                                <controls:AuthorLiveTileControl Summary="{x:Bind}" />
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="Authors_OpenProfile"
                                            Click="OpenProfile_Click"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind Display.HasProfileUrl, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE774;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Uid="Authors_RefreshOne"
                                            Click="RefreshOne_Click"
                                            Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Uid="Authors_EditLocal"
                                            Click="EditLocal_Click"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind Display.IsLocalSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource Space12}" Visibility="{x:Bind IsEmpty, Mode=OneWay}">
                    <FontIcon Glyph="&#xE721;" FontSize="32" />
                    <TextBlock x:Uid="Authors_NoResults" />
                    <Button x:Uid="SceneGallery_ResetSearch" Click="ClearSearch_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--  The same layout as the library (user request: the two pages should look
          like one app): the platforms are the title, as the library's card kinds
          are, with the count and sort on their right; the search box below with
          the page's actions beside it, where the library has filter and random.  -->
    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="{StaticResource Space12}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="{StaticResource Space12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  The title when there is no platform to pick (one platform, or the title bar names it).  -->
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level1"
                VerticalAlignment="Bottom"
                Style="{StaticResource PageTitleTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <!--  The platforms, when there is a choice: the selected one is the
                  title (large), the others small and quiet - the library's selector.  -->
            <SelectorBar
                x:Name="PlatformBar"
                x:Uid="Authors_PlatformBar"
                AutomationProperties.AutomationId="AuthorsPlatformBar"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Visibility="Collapsed"
                SelectionChanged="PlatformBar_SelectionChanged" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="{StaticResource Space8}"
                VerticalAlignment="Center">
                <!--  Refreshing: a ring and a word beside the count, as the library's busy status.  -->
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="6"
                    Margin="0,0,4,0"
                    Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}">
                    <ProgressRing Width="14" Height="14" IsActive="True" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.RefreshProgress, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    x:Name="AuthorCount"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0" />
                <DropDownButton
                    x:Name="SortButton"
                    x:Uid="Authors_Sort"
                    AutomationProperties.AutomationId="AuthorSortButton">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE8CB;" />
                        <TextBlock x:Name="SortLabel" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="SortByCount" x:Uid="Authors_SortCount" Tag="Count" GroupName="authorsort" Click="SortField_Click" />
                            <RadioMenuFlyoutItem x:Name="SortByLastUpdated" x:Uid="Authors_SortLastUpdated" Tag="LastUpdated" GroupName="authorsort" Click="SortField_Click" />
                            <RadioMenuFlyoutItem x:Name="SortByName" x:Uid="Authors_SortName" Tag="Name" GroupName="authorsort" Click="SortField_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="{StaticResource Space8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="AuthorSearchBox"
                x:Uid="Authors_SearchBox"
                AutomationProperties.AutomationId="AuthorSearchBox"
                QueryIcon="Find"
                TextChanged="AuthorSearchBox_TextChanged" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space8}">
                <!--  Wave 16: local sources left the pane; they are authors too.  -->
                <Button
                    x:Name="LocalSourcesButton"
                    AutomationProperties.AutomationId="AuthorsLocalSourcesButton"
                    Click="LocalSources_Click">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE8F4;" />
                        <TextBlock x:Uid="Authors_LocalSourcesLabel" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="Authors_RefreshAll"
                    AutomationProperties.AutomationId="AuthorsRefreshAllButton"
                    IsEnabled="{x:Bind ViewModel.IsNotRefreshing, Mode=OneWay}"
                    Command="{x:Bind ViewModel.RefreshAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="&#xE72C;" />
                        <TextBlock x:Uid="Authors_RefreshAllLabel" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="AuthorsContent" Grid.Row="2" ColumnSpacing="{StaticResource Space8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!--  The details pane (AuthorInspector, added in code).  -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ContentControl
                x:Name="TabHost"
                ContentTemplate="{StaticResource AuthorTabTemplate}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />

            <ScrollViewer
                x:Name="QuickJumpScroller"
                Grid.Column="1"
                Margin="0,4,4,0"
                VerticalAlignment="Stretch"
                VerticalScrollBarVisibility="Hidden"
                Visibility="{x:Bind ViewModel.IsSortByName, Mode=OneWay}">
                <ItemsControl
                    x:Name="QuickJumpList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:AuthorIndexItemViewModel">
                            <Button
                                Width="28"
                                Height="24"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="JumpButton_Click"
                                IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                Tag="{x:Bind Group}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Text="{x:Bind Display}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

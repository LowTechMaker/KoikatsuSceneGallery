<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KoikatsuSceneGallery.Pages.AuthorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KoikatsuSceneGallery.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:KoikatsuSceneGallery.Controls"
    xmlns:converters="using:KoikatsuSceneGallery.Converters"
    xmlns:services="using:KoikatsuSceneGallery.Services"
    xmlns:viewModels="using:KoikatsuSceneGallery.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--  One platform's authors. This was a Pivot.ItemTemplate: with a
              platform named in the title bar the pivot had exactly one tab, and
              a tab strip of one announces a choice that does not exist. The
              pivot is gone; the template is hosted directly and the platform
              picker below appears only when there is something to pick.  -->
        <DataTemplate x:Key="AuthorTabTemplate" x:DataType="viewModels:AuthorProviderTabViewModel">
            <Grid>
                <GridView x:Name="AuthorsGrid" ItemsSource="{x:Bind GroupedAuthors.View}"
                          IsItemClickEnabled="True" ItemClick="AuthorsGrid_ItemClick" SelectionMode="None"
                          Loaded="AuthorsGrid_Loaded" SizeChanged="AuthorsGrid_SizeChanged">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" GroupHeaderPlacement="Top" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style></GridView.ItemContainerStyle>
                    <GridView.GroupStyle><GroupStyle HidesIfEmpty="True">
                        <!--  The stock header container draws a divider under
                              its content and keeps its padding and min height
                              even when the header inside is collapsed — so the
                              ungrouped sorts showed a stray rule, and a band of
                              empty space, between the platform bar and the
                              first row. Bare presenter: the header template
                              brings its own spacing when it has something to
                              say.  -->
                        <GroupStyle.HeaderContainerStyle><Style TargetType="GridViewHeaderItem">
                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="GridViewHeaderItem">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </ControlTemplate>
                            </Setter.Value></Setter>
                        </Style></GroupStyle.HeaderContainerStyle>
                        <GroupStyle.HeaderTemplate><DataTemplate x:DataType="viewModels:AuthorGroupViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,12,0,8" Visibility="{x:Bind ShowHeader}">
                                <TextBlock Text="{x:Bind Header}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind CountText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate></GroupStyle.HeaderTemplate>
                    </GroupStyle></GridView.GroupStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="services:AuthorSummary">
                            <Grid Margin="4"
                                  ToolTipService.ToolTip="{x:Bind Display.ProfileUrl}">
                                <controls:AuthorLiveTileControl Summary="{x:Bind}" />
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="Authors_OpenProfile"
                                            Click="OpenProfile_Click"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind Display.HasProfileUrl, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE774;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Uid="Authors_RefreshOne"
                                            Click="RefreshOne_Click"
                                            Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Uid="Authors_EditLocal"
                                            Click="EditLocal_Click"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind Display.IsLocalSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind IsEmpty, Mode=OneWay}">
                    <FontIcon Glyph="&#xE721;" FontSize="32" />
                    <TextBlock x:Uid="Authors_NoResults" />
                    <Button x:Uid="SceneGallery_ResetSearch" Click="ClearSearch_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Uid="Authors_Title"
                Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="True" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.RefreshProgress, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Uid="Authors_RefreshAll"
                    AutomationProperties.AutomationId="AuthorsRefreshAllButton"
                    IsEnabled="{x:Bind ViewModel.IsNotRefreshing, Mode=OneWay}"
                    Command="{x:Bind ViewModel.RefreshAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock x:Uid="Authors_RefreshAllLabel" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="AuthorSearchBox"
                x:Uid="Authors_SearchBox"
                AutomationProperties.AutomationId="AuthorSearchBox"
                Height="32"
                QueryIcon="Find"
                TextChanged="AuthorSearchBox_TextChanged" />

            <!--  The count belongs with the controls that change it, not inside
                  the platform's name. It read as "Fanbox (26)" — a heading
                  carrying a statistic — which is how the galleries used to do
                  it before the same move was made there.  -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="AuthorCount"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0" />
                <!--  Same control as the galleries' sort: three exclusive
                      values behind one button, with the current one on its
                      face. A ComboBox here spelt the same thing differently
                      two pages apart.  -->
                <DropDownButton
                    x:Name="SortButton"
                    x:Uid="Authors_Sort"
                    AutomationProperties.AutomationId="AuthorSortButton"
                    Height="32">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                        <TextBlock x:Name="SortLabel" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="SortByCount" x:Uid="Authors_SortCount" Tag="Count" GroupName="authorsort" Click="SortField_Click" />
                            <RadioMenuFlyoutItem x:Name="SortByLastUpdated" x:Uid="Authors_SortLastUpdated" Tag="LastUpdated" GroupName="authorsort" Click="SortField_Click" />
                            <RadioMenuFlyoutItem x:Name="SortByName" x:Uid="Authors_SortName" Tag="Name" GroupName="authorsort" Click="SortField_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!--  Only present while the choice is real: the title bar names the
              platform whenever one is selected, and repeating that here as a
              selected tab said the same thing twice, louder than the control
              that actually decides it.

              SelectorBar rather than Segmented: this is the same underlined
              text strip the library selector uses, and it is what this page
              looked like when the platforms were pivot headers. Segmented's
              filled pills read as a filter chip row — a different promise from
              "these are the sections of this page".  -->
        <SelectorBar
            x:Name="PlatformBar"
            x:Uid="Authors_PlatformBar"
            Grid.Row="2"
            AutomationProperties.AutomationId="AuthorsPlatformBar"
            HorizontalAlignment="Left"
            Visibility="Collapsed"
            SelectionChanged="PlatformBar_SelectionChanged" />

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ContentControl
                x:Name="TabHost"
                ContentTemplate="{StaticResource AuthorTabTemplate}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />

            <ScrollViewer
                x:Name="QuickJumpScroller"
                Grid.Column="1"
                Margin="0,4,4,0"
                VerticalAlignment="Stretch"
                VerticalScrollBarVisibility="Hidden"
                Visibility="{x:Bind ViewModel.IsSortByName, Mode=OneWay}">
                <ItemsControl
                    x:Name="QuickJumpList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:AuthorIndexItemViewModel">
                            <Button
                                Width="28"
                                Height="24"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="JumpButton_Click"
                                IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                Tag="{x:Bind Group}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Text="{x:Bind Display}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

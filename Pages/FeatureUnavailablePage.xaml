<?xml version="1.0" encoding="utf-8" ?>
<!--  What a pane entry shows while the plugin behind it is not installed.
      The entries used to disappear instead, so someone without the plugin had
      no way to learn that authors, tags or importing existed at all.  -->
<Page
    x:Class="KoikatsuSceneGallery.Pages.FeatureUnavailablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PageContentPaddingClosed}">
        <StackPanel
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <FontIcon
                x:Name="FeatureIcon"
                HorizontalAlignment="Center"
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level1"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="DescriptionText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Uid="FeatureUnavailable_PluginHint"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Uid="FeatureUnavailable_OpenPlugins"
                AutomationProperties.AutomationId="FeatureUnavailableOpenPlugins"
                HorizontalAlignment="Center"
                Click="OpenPlugins_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>

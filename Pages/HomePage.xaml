<Page
    x:Class="KoikatsuSceneGallery.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KoikatsuSceneGallery.Controls">
    <!--  A dashboard (user's pick): today's featured card beside the library's
          numbers, then the shelves as panels, two or three to a row. No details
          pane: a click opens the card in place (the loupe), and a panel's
          "see all" opens its whole list in the library's browser.  -->
    <Grid
        x:Name="PageRoot"
        Padding="{StaticResource PageContentPadding}"
        RowSpacing="{StaticResource PageRowSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  "New themes" in the header's actions, not a row under the panels: that
              row was what still pushed the page past a maximised window (user report).  -->
        <controls:PageHeader x:Name="Header" x:Uid="Home_Header">
            <controls:PageHeader.Actions>
                <Button
                    x:Name="RerollButton"
                    AutomationProperties.AutomationId="HomeThemesReroll"
                    Click="Reroll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <FontIcon FontSize="{StaticResource IconSize}" Glyph="{StaticResource GlyphRefresh}" />
                        <TextBlock x:Uid="Home_ThemesRerollLabel" />
                    </StackPanel>
                </Button>
            </controls:PageHeader.Actions>
        </controls:PageHeader>
        <ScrollViewer
            x:Name="ShelvesScroll"
            Grid.Row="1"
            AutomationProperties.AutomationId="HomeScroll"
            VerticalScrollBarVisibility="Auto">
            <!--  The right margin is the scroll bar's gutter, as in the library.  -->
            <StackPanel
                x:Name="Dashboard"
                Margin="0,0,16,4"
                Spacing="{x:Bind controls:UiMetrics.HomePanelGap}">
                <Grid x:Name="TopBand" />
                <Grid x:Name="PanelsGrid" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

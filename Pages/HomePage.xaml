<Page
    x:Class="KoikatsuSceneGallery.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KoikatsuSceneGallery.Controls">
    <Grid
        x:Name="PageRoot"
        Padding="{StaticResource PageContentPadding}"
        RowSpacing="{StaticResource PageRowSpacing}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="Inspector_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  The second column is the details pane (CardInspector, added in code),
              the same one the library has; the loupe covers the shelves' cell.  -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:PageHeader x:Uid="Home_Header" Grid.ColumnSpan="2" />
        <!--  The shelves are built in code (HomePage.xaml.cs): one CardShelf
              per HomeViewModel shelf, in the view model's order.  -->
        <ScrollViewer
            x:Name="ShelvesScroll"
            Grid.Row="1"
            AutomationProperties.AutomationId="HomeScroll"
            VerticalScrollBarVisibility="Auto">
            <!--  The right margin is room for the vertical scroll bar, which WinUI
                  draws over the content: without it the bar covers the shelf
                  headers' buttons (seen live at 1920x1080).  -->
            <StackPanel
                x:Name="Shelves"
                Margin="0,0,16,24"
                Spacing="{StaticResource Space16}">
                <!--  "This or that" first; the shelves are added after it in code.  -->
                <controls:DuelPanel x:Name="Duel" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

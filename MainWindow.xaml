<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="KoikatsuSceneGallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KoikatsuSceneGallery"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Koikatsu Scene Gallery"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Koikatsu Scene Gallery"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <!--  Inside TitleBar.Content, not beside AppTitleBar: the control
                  carves its own input passthrough, while anything sitting in
                  row 0 next to it would be swallowed by SetTitleBar.  -->
            <TitleBar.Content>
                <!--  Built in code: the items are the platforms whose plugin
                      is installed, which is not known until startup. MaxWidth
                      still matters — Segmented derives from ListViewBase and
                      claims the full width at measure, which once left the
                      window with no room for its own title.  -->
                <Grid
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <controls:Segmented
                        x:Name="OriginSelectorBar"
                        x:Uid="Origin_SelectorBar"
                        AutomationProperties.AutomationId="OriginSelectorBar"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        SelectionChanged="OriginSelectorBar_SelectionChanged" />
                    <DropDownButton
                        x:Name="OriginSelectorPicker"
                        x:Uid="Origin_SelectorBar"
                        AutomationProperties.AutomationId="OriginSelectorPicker"
                        Width="150"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="OriginSelectorMenu" Placement="BottomEdgeAlignedLeft" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            AutomationProperties.AutomationId="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            ItemInvoked="NavView_ItemInvoked"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="LibraryNavItem"
                    x:Uid="Nav_Library"
                    AutomationProperties.AutomationId="LibraryNavItem"
                    IsSelected="True"
                    Tag="library"
                    ToolTipService.ToolTip="{x:Null}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DiscoveryNavItem" x:Uid="Nav_Discovery"
                                    Tag="discovery" AutomationProperties.AutomationId="DiscoveryNavItem">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Shown only when an author plugin is installed (see ctor).  -->
                <NavigationViewItem
                    x:Name="AuthorsNavItem"
                    x:Uid="Nav_Authors"
                    AutomationProperties.AutomationId="AuthorsNavItem"
                    Tag="authors"
                    ToolTipService.ToolTip="{x:Null}"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Shown only when an import provider is installed: without one no
                      sidecar can exist, so there can never be any tags.  -->
                <NavigationViewItem
                    x:Name="TagsNavItem"
                    x:Uid="Nav_Tags"
                    AutomationProperties.AutomationId="TagsNavItem"
                    Tag="tags"
                    ToolTipService.ToolTip="{x:Null}"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="LocalSourcesNavItem"
                    x:Uid="Nav_LocalSources"
                    AutomationProperties.AutomationId="LocalSourcesNavItem"
                    Tag="localsources"
                    ToolTipService.ToolTip="{x:Null}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!--  The row navigates to the log; the switch on the right turns
                      recording on and off without leaving the page you are on.  -->
                <NavigationViewItem
                    x:Name="UsageNavItem"
                    x:Uid="Nav_Usage"
                    AutomationProperties.AutomationId="UsageNavItem"
                    Tag="usage"
                    ToolTipService.ToolTip="{x:Null}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="Nav_Usage_Label"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <ToggleSwitch
                            x:Name="RecordModeNavToggle"
                            x:Uid="Record_NavToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            AutomationProperties.AutomationId="RecordModeNavToggle"
                            OffContent=""
                            OnContent=""
                            PointerPressed="RecordModeNavToggle_PointerPressed"
                            Toggled="RecordModeNavToggle_Toggled" />
                    </Grid>
                </NavigationViewItem>
                <!--  Shown only when an import provider plugin is installed (see ctor).  -->
                <NavigationViewItem
                    x:Name="ImportNavItem"
                    x:Uid="Nav_Import"
                    AutomationProperties.AutomationId="ImportNavItem"
                    Tag="import"
                    ToolTipService.ToolTip="{x:Null}"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid>
                <!--  Same cell as the frame, not a row above it: this is the
                      page's title, and the page's own controls belong on the
                      line with it rather than below an empty band. The browser
                      keeps its left column clear for it, and adds top padding
                      back when it does need that column (a group drill-down
                      puts the group's name there).  -->
                <SelectorBar
                    x:Name="LibrarySelectorBar"
                    Canvas.ZIndex="1"
                    AutomationProperties.AutomationId="LibrarySelectorBar"
                    Margin="24,16,24,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    SelectionChanged="LibrarySelectorBar_SelectionChanged">
                    <SelectorBarItem
                        x:Name="ScenesSelectorItem"
                        x:Uid="Library_Scenes"
                        AutomationProperties.AutomationId="LibraryScenesSelectorItem"
                        IsSelected="True" />
                    <SelectorBarItem
                        x:Name="CharactersSelectorItem"
                        x:Uid="Library_Characters"
                        AutomationProperties.AutomationId="LibraryCharactersSelectorItem" />
                    <SelectorBarItem
                        x:Name="CoordinatesSelectorItem"
                        x:Uid="Library_Coordinates"
                        AutomationProperties.AutomationId="LibraryCoordinatesSelectorItem" />
                </SelectorBar>

                <Frame
                    x:Name="NavFrame"
                    AutomationProperties.AutomationId="NavFrame"
                    Navigated="NavFrame_Navigated" />
            </Grid>
        </NavigationView>

        <!--  The artwork re-fetch runs for hours after its dialog is closed.
              Floating over the content rather than a row of its own: it is
              there only while that run is, and the pages below keep their
              layout whether it shows or not.  -->
        <!--  The host gives it a floor. InfoBar's severity fills are
              translucent — right inside a page, where the page is behind them,
              but floating over arbitrary content the text read against
              whatever list happened to be underneath. Opaque tertiary, the
              same fill the import page's floating card settled on.  -->
        <Border
            x:Name="RefetchBannerHost"
            Grid.Row="1"
            Canvas.ZIndex="10"
            MaxWidth="460"
            Margin="0,0,24,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Translation="0,0,32"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <InfoBar
                x:Name="RefetchBanner"
                AutomationProperties.AutomationId="RefetchBanner"
                BorderThickness="0"
                IsOpen="False"
                IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="RefetchBannerStop" x:Uid="Refetch_BannerStop" Click="RefetchBannerStop_Click" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <ProgressBar x:Name="RefetchBannerProgress" Margin="0,0,0,12" Minimum="0" />
                </InfoBar.Content>
            </InfoBar>
        </Border>
    </Grid>
</Window>

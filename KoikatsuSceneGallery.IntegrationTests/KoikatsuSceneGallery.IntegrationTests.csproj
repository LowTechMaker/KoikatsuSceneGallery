<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <!-- The referenced host owns runtime initialization; do not emit duplicate initializer types. -->
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);XamlHost\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Update="DispatcherQueue.manifest" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\KoikatsuSceneGallery.csproj" AdditionalProperties="Platform=x64;WindowsAppSDKSelfContained=true" />
    <ProjectReference Include="XamlHost\KoikatsuSceneGallery.XamlTestHost.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
  </ItemGroup>
  <Target Name="CopyXamlTestHost" AfterTargets="Build">
    <MSBuild Projects="XamlHost\KoikatsuSceneGallery.XamlTestHost.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_XamlHostTarget" />
    </MSBuild>
    <PropertyGroup>
      <_XamlHostOutputDirectory>@(_XamlHostTarget->'%(RootDir)%(Directory)')</_XamlHostOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_XamlHostFiles Include="$(_XamlHostOutputDirectory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlHostFiles)" DestinationFiles="@(_XamlHostFiles->'$(OutDir)XamlHost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>

<?xml version="1.0" encoding="utf-8" ?>
<!--  The app's shared design tokens. A value lives here once it is used by
      more than one page, or is a colour that has to answer to the theme.
      Pages refer to these by key instead of repeating literals: the same
      dark badge used to be spelt #CC202020, #E6202020 and #AA000000 on three
      pages, and nothing said they were meant to be the same thing.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  First: the compiler wants the plain resources in one run, not split around it.  -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="RatingR18GBadgeBrush" Color="#FF4060" />
            <SolidColorBrush x:Key="RatingR18BadgeBrush" Color="#FF4060" />
            <SolidColorBrush x:Key="RatingAllAgesBadgeBrush" Color="#2E7D32" />
            <SolidColorBrush x:Key="RatingBadgeForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="LiveTileOverlayForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="LiveTileOverlaySecondaryBrush" Color="#CCFFFFFF" />
            <Color x:Key="LiveTileScrimEndColor">#CC000000</Color>
            <!--  "Already in the library": orange, not the caution yellow - nothing is lost.  -->
            <SolidColorBrush x:Key="AttentionTextBrush" Color="#E8892B" />
            <!--  Over the filmstrip's pictures that are not the current one.  -->
            <SolidColorBrush x:Key="FilmstripVeilBrush" Color="#99000000" />
            <!--  Badges drawn over a thumbnail. They sit on arbitrary pixels, so
                  they stay dark in both themes: a light badge on a light
                  picture disappears.  -->
            <SolidColorBrush x:Key="MediaOverlayBadgeBackgroundBrush" Color="#E6202020" />
            <!--  The group count, a step lighter so it reads as glass rather
                  than a label stuck on the card (phase 108).  -->
            <SolidColorBrush x:Key="MediaOverlayBadgeSubtleBackgroundBrush" Color="#CC202020" />
            <SolidColorBrush x:Key="MediaOverlayForegroundBrush" Color="White" />
            <!--  A library card with its caption (file names on). Opaque and a
                  clear step lighter than the page: the translucent card fill
                  barely parted one card from the next (user report).  -->
            <SolidColorBrush x:Key="MediaCardBackgroundBrush" Color="#FF363636" />
            <SolidColorBrush x:Key="MediaCardStrokeBrush" Color="#24FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="RatingR18GBadgeBrush" Color="#FF4060" />
            <SolidColorBrush x:Key="RatingR18BadgeBrush" Color="#FF4060" />
            <SolidColorBrush x:Key="RatingAllAgesBadgeBrush" Color="#2E7D32" />
            <SolidColorBrush x:Key="RatingBadgeForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="LiveTileOverlayForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="LiveTileOverlaySecondaryBrush" Color="#CCFFFFFF" />
            <Color x:Key="LiveTileScrimEndColor">#CC000000</Color>
            <!--  "Already in the library": orange, not the caution yellow - nothing is lost.  -->
            <SolidColorBrush x:Key="AttentionTextBrush" Color="#E8892B" />
            <!--  Over the filmstrip's pictures that are not the current one.  -->
            <SolidColorBrush x:Key="FilmstripVeilBrush" Color="#99000000" />
            <SolidColorBrush x:Key="MediaOverlayBadgeBackgroundBrush" Color="#E6202020" />
            <SolidColorBrush x:Key="MediaOverlayBadgeSubtleBackgroundBrush" Color="#CC202020" />
            <SolidColorBrush x:Key="MediaOverlayForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="MediaCardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MediaCardStrokeBrush" Color="#1F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="RatingR18GBadgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RatingR18BadgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RatingAllAgesBadgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RatingBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="LiveTileOverlayForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="LiveTileOverlaySecondaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <Color x:Key="LiveTileScrimEndColor">#CC000000</Color>
            <SolidColorBrush x:Key="AttentionTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FilmstripVeilBrush" Color="#99000000" />
            <SolidColorBrush x:Key="MediaOverlayBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MediaOverlayBadgeSubtleBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MediaOverlayForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MediaCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MediaCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  Page layout. Content that scrolls to the window's bottom edge uses
          the open variant; pages whose content ends above it close it.  -->
    <Thickness x:Key="PageContentPadding">24,16,24,0</Thickness>
    <Thickness x:Key="PageContentPaddingClosed">24,16,24,24</Thickness>
    <x:Double x:Key="PageRowSpacing">12</x:Double>
    <!--  A page that ends at the window's bottom edge with its own margin:
          the card viewer and the post page.  -->
    <Thickness x:Key="DetailContentPadding">24,16,24,16</Thickness>

    <!--  The spacing scale (wave 2 of centralising values): Spacing, RowSpacing and
          ColumnSpacing use these four steps instead of literals. About 200 uses of
          4 / 8 / 12 / 16 were written out by hand across the pages.  -->
    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>

    <!--  Sizes shared across pages.  -->
    <x:Double x:Key="IconSize">14</x:Double>
    <x:Double x:Key="RingSize">16</x:Double>
    <!--  The message shown when a list is empty (library, tags, usage, rating, discovery, settings search).  -->
    <x:Double x:Key="EmptyStateMaxWidth">480</x:Double>
    <!--  A small label pill: the title bar's rating toggles, the import page's rating chip.  -->
    <Thickness x:Key="BadgePadding">6,1</Thickness>

    <!--  Small text styles that were set inline over and over.  -->
    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="TileTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!--  Icons, one name per meaning: generated from Helpers/Glyphs.cs (wave 3 of
          centralising values); keep the two in step. FontIcon Glyph="{StaticResource GlyphQueue}".  -->
    <x:String x:Key="GlyphHome">&#xE80F;</x:String>
    <x:String x:Key="GlyphLibrary">&#xE8B9;</x:String>
    <x:String x:Key="GlyphScene">&#xE8B9;</x:String>
    <x:String x:Key="GlyphCharacter">&#xE76E;</x:String>
    <x:String x:Key="GlyphCoordinate">&#xE78A;</x:String>
    <x:String x:Key="GlyphAuthor">&#xE77B;</x:String>
    <x:String x:Key="GlyphAuthors">&#xE716;</x:String>
    <x:String x:Key="GlyphLocalSources">&#xE8F4;</x:String>
    <x:String x:Key="GlyphDiscovery">&#xE8B1;</x:String>
    <x:String x:Key="GlyphShuffle">&#xE8B1;</x:String>
    <x:String x:Key="GlyphRating">&#xE734;</x:String>
    <x:String x:Key="GlyphTags">&#xE8EC;</x:String>
    <x:String x:Key="GlyphUsage">&#xE81C;</x:String>
    <x:String x:Key="GlyphRecord">&#xE7C8;</x:String>
    <x:String x:Key="GlyphImport">&#xE896;</x:String>
    <x:String x:Key="GlyphSettings">&#xE713;</x:String>
    <x:String x:Key="GlyphPosts">&#xE8F1;</x:String>
    <x:String x:Key="GlyphQueue">&#xE718;</x:String>
    <x:String x:Key="GlyphLike">&#xEB51;</x:String>
    <x:String x:Key="GlyphHide">&#xED1A;</x:String>
    <x:String x:Key="GlyphSelected">&#xE73E;</x:String>
    <x:String x:Key="GlyphOpen">&#xE8A7;</x:String>
    <x:String x:Key="GlyphOpenFolder">&#xED43;</x:String>
    <x:String x:Key="GlyphCopyFile">&#xE8C8;</x:String>
    <x:String x:Key="GlyphCopyLink">&#xE71B;</x:String>
    <x:String x:Key="GlyphAdd">&#xE710;</x:String>
    <x:String x:Key="GlyphRemove">&#xE711;</x:String>
    <x:String x:Key="GlyphDelete">&#xE74D;</x:String>
    <x:String x:Key="GlyphEdit">&#xE70F;</x:String>
    <x:String x:Key="GlyphRefresh">&#xE72C;</x:String>
    <x:String x:Key="GlyphWeb">&#xE774;</x:String>
    <x:String x:Key="GlyphSearch">&#xE721;</x:String>
    <x:String x:Key="GlyphFilter">&#xE71C;</x:String>
    <x:String x:Key="GlyphSort">&#xE8CB;</x:String>
    <x:String x:Key="GlyphSortDescending">&#xE74B;</x:String>
    <x:String x:Key="GlyphSortAscending">&#xE74A;</x:String>
    <x:String x:Key="GlyphMore">&#xE712;</x:String>
    <x:String x:Key="GlyphClose">&#xE711;</x:String>
    <x:String x:Key="GlyphBack">&#xE72B;</x:String>
    <x:String x:Key="GlyphPrevious">&#xE76B;</x:String>
    <x:String x:Key="GlyphNext">&#xE76C;</x:String>
    <x:String x:Key="GlyphChevronDown">&#xE70D;</x:String>
    <x:String x:Key="GlyphZoomIn">&#xE8A3;</x:String>
    <x:String x:Key="GlyphZoomOut">&#xE71F;</x:String>
    <x:String x:Key="GlyphDetailsPane">&#xE8A0;</x:String>
    <x:String x:Key="GlyphThumbnail">&#xE91B;</x:String>
    <x:String x:Key="GlyphFolder">&#xE8B7;</x:String>
    <x:String x:Key="GlyphArrowRight">&#xE72A;</x:String>
    <x:String x:Key="GlyphDone">&#xE930;</x:String>
    <x:String x:Key="GlyphWarning">&#xE7BA;</x:String>
    <x:String x:Key="GlyphError">&#xEA39;</x:String>
    <x:String x:Key="GlyphInLibrary">&#xE8F1;</x:String>

    <!--  Headings, sized for a desktop window (wave 11). The built-in Title
          style (28 px) made every page open like a phone screen's big title;
          a page title is now 20 px and a section heading 16 px semibold.
          Empty-state messages keep SubtitleTextBlockStyle.  -->
    <!--  Plain setters rather than BasedOn the built-in styles: this file is
          its own merged dictionary, and a missed StaticResource here would
          only show as a crash at start.  -->
    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <!--  Library tiles and the stacked cards behind a group (phase 108).  -->
    <!--  Every corner in the app comes from a resource, so the "square corners"
          setting (App.ApplyCornerStyle) can set them all to zero at start:
          ControlCornerRadius (4) and OverlayCornerRadius (8) are WinUI's own,
          these two cover the sizes in between and above.  -->
    <CornerRadius x:Key="SurfaceCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="LargeCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="MediaTileCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="MediaOverlayBadgeCornerRadius">4</CornerRadius>

    <!--  A floating card over page content: the refetch banner and toasts.
          InfoBar's own fills are translucent, which reads fine inside a page
          but not floating over whatever list happens to be underneath.  -->
    <Style x:Key="FloatingSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
    </Style>

    <Style x:Key="MediaOverlayBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="CornerRadius" Value="{StaticResource MediaOverlayBadgeCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource MediaOverlayBadgeBackgroundBrush}" />
    </Style>
</ResourceDictionary>
